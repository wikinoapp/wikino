package suggestion_change

import (
	"fmt"

	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// IndexData は編集提案の変更差分画面に渡すデータ構造体です
type IndexData struct {
	CSRFToken                string
	Space                    viewmodel.Space
	Topic                    viewmodel.Topic
	Suggestion               viewmodel.SuggestionForDetail
	SuggestionPages          []viewmodel.SuggestionPageForList
	PageDiffs                []viewmodel.SuggestionPageDiff
	CanEditSuggestionPages   bool
	CanAddSuggestionPage     bool
	CanRemoveSuggestionPage  bool
}

// pageDiffEditData は差分表示内の編集・削除ボタンに必要なデータです
type pageDiffEditData struct {
	CSRFToken        string
	SpaceIdentifier  viewmodel.SpaceIdentifier
	SuggestionNumber int32
	CanEdit          bool
	CanRemove        bool
	PageCount        int
}

// Index は編集提案の変更差分画面のコンテンツを表示します
templ Index(data IndexData) {
	<div class="py-4">
		<div class="max-w-3xl w-full mx-auto">
			<div class="flex flex-col gap-6">
				<div class="flex flex-col gap-4">
					<div class="px-4">
						@components.MainTitle(components.MainTitleData{
							Title:   data.Suggestion.Title,
							Content: components.SuggestionTitleContent(data.Suggestion.Status, data.Suggestion.Number),
						})
					</div>

					<div class="px-0 md:px-4">
						@components.SubNav([]components.SubNavItem{
							{
								Label:          templates.T(ctx, "suggestion_show_conversation_tab"),
								Path:           string(templates.SuggestionShowPath(data.Space.Identifier, data.Suggestion.Number)),
								IconName:       "chats-circle-regular",
								ActiveIconName: "chats-circle-fill",
							},
							{
								Label:          templates.T(ctx, "suggestion_show_changed_pages_tab"),
								Path:           string(templates.SuggestionChangesPath(data.Space.Identifier, data.Suggestion.Number)),
								IconName:       "files-regular",
								ActiveIconName: "files-fill",
								IsActive:       true,
								Badge:          fmt.Sprintf("%d", len(data.SuggestionPages)),
							},
						})
					</div>
				</div>

				<div class="flex flex-col gap-4">
					if len(data.PageDiffs) == 0 {
						<div class="px-4">
							<p class="text-sm text-muted-foreground">
								{ templates.T(ctx, "diff_no_changes") }
							</p>
						</div>
					} else {
						<div class="flex flex-col gap-4">
							for _, pd := range data.PageDiffs {
								@components.ContentCard() {
									@suggestionPageDiff(pageDiffEditData{
										CSRFToken:        data.CSRFToken,
										SpaceIdentifier:  data.Space.Identifier,
										SuggestionNumber: data.Suggestion.Number,
										CanEdit:          data.CanEditSuggestionPages,
										CanRemove:        data.CanRemoveSuggestionPage,
										PageCount:        len(data.PageDiffs),
									}, pd)
								}
							}
						</div>
					}

					if data.CanAddSuggestionPage {
						<div class="px-4">
							<a
								href={ templ.SafeURL(string(templates.SuggestionPageNewPath(data.Space.Identifier, data.Suggestion.Number))) }
								class="btn rounded-full"
								data-variant="secondary"
							>
								@templates.Icon("file-plus-regular", "size-4")
								{ templates.T(ctx, "suggestion_change_add_page_button") }
							</a>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// suggestionPageDiff は1つの編集提案ページの差分を表示します
templ suggestionPageDiff(editData pageDiffEditData, pd viewmodel.SuggestionPageDiff) {
	<div class="flex flex-col gap-2">
		<div class="flex items-center justify-between">
			if pd.HasTitleChange {
				<a
					href={ templ.SafeURL(string(templates.PagePath(editData.SpaceIdentifier, pd.PageNumber))) }
					class="flex items-center gap-1 hover:underline"
				>
					if pd.OldTitle != "" {
						<span class="text-sm font-semibold">
							{ pd.OldTitle }
						</span>

						@templates.Icon("arrow-right-regular", "size-3")
					}

					<span class="text-sm font-semibold">
						{ pd.NewTitle }
					</span>
				</a>
			} else {
				<a
					href={ templ.SafeURL(string(templates.PagePath(editData.SpaceIdentifier, pd.PageNumber))) }
					class="text-sm font-semibold hover:underline"
				>
					{ pd.PageTitle }
				</a>
			}

			<div class="flex items-center gap-4">
				if editData.CanEdit {
					<form
						action={ templ.SafeURL(string(templates.SuggestionPageEditsPath(editData.SpaceIdentifier, editData.SuggestionNumber))) }
						method="POST"
					>
						<input type="hidden" name="csrf_token" value={ editData.CSRFToken }/>
						<input type="hidden" name="suggestion_page_id" value={ pd.SuggestionPageID }/>
						<button
							class="btn h-fit p-0"
							data-variant="link"
							data-size="sm"
							type="submit"
						>
							@templates.Icon("pencil-simple-line-regular", "size-3")
							{ templates.T(ctx, "suggestion_page_edit_button") }
						</button>
					</form>
				}
				if editData.CanRemove && editData.PageCount >= 2 {
					<form
						action={ templ.SafeURL(string(templates.SuggestionPagePath(editData.SpaceIdentifier, editData.SuggestionNumber, pd.SuggestionPageID))) }
						data-confirm={ templates.T(ctx, "suggestion_change_remove_page_confirm") }
						hx-on:submit="if (!confirm(this.dataset.confirm)) { event.preventDefault(); return false; }"
						method="POST"
					>
						<input type="hidden" name="_method" value="DELETE"/>
						<input type="hidden" name="csrf_token" value={ editData.CSRFToken }/>
						<button
							class="btn h-fit p-0 text-error"
							data-variant="link"
							data-size="sm"
							type="submit"
						>
							@templates.Icon("trash-regular", "size-3")
							{ templates.T(ctx, "suggestion_change_remove_page_button") }
						</button>
					</form>
				}
			</div>
		</div>

		@components.DiffView(components.DiffViewData{
			Blocks: pd.BodyBlocks,
		})
	</div>
}
