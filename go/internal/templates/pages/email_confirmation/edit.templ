package email_confirmation

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// EditPageData は確認コード入力ページに渡すデータ構造体です
type EditPageData struct {
	CSRFToken  string
	FormErrors *model.ValidationError
}

// Edit は確認コード入力ページのコンテンツを表示します
templ Edit(data EditPageData) {
	<div class="max-w-lg w-full flex flex-col gap-6">
		<div class="text-center px-4">
			<a href="/" aria-label={ templates.T(ctx, "home_link_aria_label") } class="inline-block">
				<div class="bg-primary rounded-xl">
					@templates.DecorativeIcon("logo", "fill-primary-foreground w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2 px-4">
			<h1 class="text-center text-3xl text-primary font-bold antialiased">
				{ templates.T(ctx, "email_confirmation_edit_heading") }
			</h1>

			<p class="text-center text-sm text-muted-foreground whitespace-pre-line">
				{ templates.T(ctx, "email_confirmation_edit_description") }
			</p>
		</div>

		@components.FormErrorSummary(data.FormErrors)

		@components.ContentCard() {
			<form
				action="/email_confirmation"
				class="grid gap-6"
				hx-on:submit="disableSubmitButtons(this)"
				method="POST"
			>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="_method" value="PATCH"/>

				<div class="grid gap-2">
					<label class="label" for="code">
						{ templates.T(ctx, "email_confirmation_edit_code_label") }
					</label>

					<input
						if data.FormErrors != nil && data.FormErrors.HasFieldError("code") {
							aria-invalid="true"
						} else {
							aria-invalid="false"
						}
						autocomplete="one-time-code"
						autofocus
						class="input"
						id="code"
						maxlength="6"
						name="code"
						placeholder="ABCD12"
						required
						tabindex="1"
						type="text"
					/>

					<p class="text-sm text-muted-foreground">
						{ templates.T(ctx, "email_confirmation_edit_code_hint") }
					</p>

					if data.FormErrors != nil && data.FormErrors.HasFieldError("code") {
						for _, errorMsg := range data.FormErrors.GetFieldErrors("code") {
							<p class="text-sm text-error">
								{ errorMsg }
							</p>
						}
					}
				</div>

				<button
					class="btn rounded-full w-fit"
					tabindex="2"
					type="submit"
				>
					@templates.Icon("arrow-right-regular")
					{ templates.T(ctx, "email_confirmation_edit_submit_button") }
				</button>
			</form>
		}

		<div class="text-center px-4">
			<a href="/sign_up" class="link-foreground inline-flex items-center gap-1">
				@templates.Icon("arrow-left-regular", "w-4 h-4")
				{ templates.T(ctx, "email_confirmation_edit_back_to_sign_up") }
			</a>
		</div>
	</div>
}
