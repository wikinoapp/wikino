package oauth_authorization

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// HiddenFieldは、同意の送信に引き継ぐ認可要求のパラメーター
type HiddenField struct {
	Name  string
	Value string
}

// NewDataは同意画面をレンダリングする元になるデータ。
//
// NotMemberとNoPermissionのどちらかが真なら、ログイン中のユーザーは連携先のスペースで
// アプリを許可できず、同意の代わりにその理由とクライアントへ戻るボタンを示す。
// ScopeOptionsは要求されたスコープの選択肢で、FormErrorsは拒否された送信のエラー。
type NewData struct {
	CSRFToken       string
	HiddenFields    []HiddenField
	ApplicationName string
	SpaceName       string
	UserAtname      string
	ScopeOptions    []components.APITokenScopeOption
	RedirectHost    string
	NotMember       bool
	NoPermission    bool
	FormErrors      *model.ValidationError
}

// Newは外部アプリからの認可要求を利用者に示し、許可するか拒否するかを選ばせる画面を表示します。
templ New(data NewData) {
	<div class="max-w-lg w-full flex flex-col gap-6">
		<div class="flex flex-col gap-2 px-4">
			<h1 class="text-center text-2xl font-bold antialiased">
				if data.NotMember || data.NoPermission {
					{ templates.T(ctx, "oauth_authorization_new_denied_heading", map[string]any{"ApplicationName": data.ApplicationName}) }
				} else {
					{ templates.T(ctx, "oauth_authorization_new_heading", map[string]any{"ApplicationName": data.ApplicationName}) }
				}
			</h1>
		</div>

		@components.ContentCard() {
			<form action="/oauth/authorize" class="grid gap-6" method="POST">
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				for _, field := range data.HiddenFields {
					<input type="hidden" name={ field.Name } value={ field.Value }/>
				}

				<dl class="grid gap-4">
					<div class="grid gap-1">
						<dt class="text-sm text-muted-foreground">
							{ templates.T(ctx, "oauth_authorization_new_space_label") }
						</dt>
						<dd class="font-bold">{ data.SpaceName }</dd>
					</div>
					<div class="grid gap-1">
						<dt class="text-sm text-muted-foreground">
							{ templates.T(ctx, "oauth_authorization_new_user_label") }
						</dt>
						<dd>{ "@" + data.UserAtname }</dd>
					</div>
				</dl>

				if data.NotMember {
					<p>{ templates.T(ctx, "oauth_authorization_new_not_member") }</p>
				} else if data.NoPermission {
					<p>{ templates.T(ctx, "oauth_authorization_new_no_permission") }</p>
				} else {
					// 選択肢のグループは個人用アクセストークンの発行画面と同じく、basecoatの .fieldsetでまとめます。
					<fieldset class="fieldset gap-3">
						<legend class="label">
							{ templates.T(ctx, "oauth_authorization_new_scopes_label", map[string]any{"ApplicationName": data.ApplicationName}) }
						</legend>
						<p class="text-muted-foreground text-sm">
							{ templates.T(ctx, "oauth_authorization_new_scopes_hint") }
						</p>
						if hasScopesError(data.FormErrors) {
							<div id={ scopesErrorID }>
								for _, errorMsg := range data.FormErrors.GetFieldErrors(grantedScopesField) {
									<p class="text-sm text-error">{ errorMsg }</p>
								}
							</div>
						}
						@components.APITokenScopeCheckboxes(components.APITokenScopeCheckboxesData{
							Name:      grantedScopesField,
							Options:   data.ScopeOptions,
							ErrorID:   scopesErrorIDIf(hasScopesError(data.FormErrors)),
							Autofocus: hasScopesError(data.FormErrors),
						})
					</fieldset>
				}

				<p class="text-sm text-muted-foreground">
					if data.NotMember || data.NoPermission {
						{ templates.T(ctx, "oauth_authorization_new_back_notice", map[string]any{"RedirectHost": data.RedirectHost}) }
					} else {
						{ templates.T(ctx, "oauth_authorization_new_redirect_notice", map[string]any{"RedirectHost": data.RedirectHost}) }
					}
				</p>

				<div class="flex flex-wrap gap-2">
					if !data.NotMember && !data.NoPermission {
						<button class="btn rounded-full" name="decision" type="submit" value="approve">
							{ templates.T(ctx, "oauth_authorization_new_approve") }
						</button>
						<button class="btn rounded-full" data-variant="outline" name="decision" type="submit" value="deny">
							{ templates.T(ctx, "oauth_authorization_new_deny") }
						</button>
					} else {
						<button class="btn rounded-full" data-variant="outline" name="decision" type="submit" value="deny">
							{ templates.T(ctx, "oauth_authorization_new_back_to_application") }
						</button>
					}
				</div>
			</form>
		}
	</div>
}

// grantedScopesFieldは、利用者が選んだ付与するスコープを送るフォームの項目名
const grantedScopesField = "granted_scopes"

// scopesErrorIDは、スコープの選択のエラーを収める要素のid
const scopesErrorID = grantedScopesField + "-error"

// hasScopesErrorは、拒否された送信にスコープの選択のエラーがあるかを返します。
func hasScopesError(formErrors *model.ValidationError) bool {
	return formErrors != nil && formErrors.HasFieldError(grantedScopesField)
}

// scopesErrorIDIfは、エラーがあればチェックボックスから参照するエラーの要素のidを返します。
func scopesErrorIDIf(hasError bool) string {
	if hasError {
		return scopesErrorID
	}
	return ""
}
