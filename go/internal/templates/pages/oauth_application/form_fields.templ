package oauth_application

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// FormFieldsDataはアプリの名前とリダイレクトURIの項目をレンダリングする元になるデータ。
// NameとRedirectURIsは送信された値をフォームへ戻すためのもので、拒否された送信でも入力した
// 内容が残るようにする。
type FormFieldsData struct {
	FormErrors   *model.ValidationError
	Name         string
	RedirectURIs string
}

// formFieldsは登録フォームと編集フォームが共有する項目を表示します。どちらも同じ規則で
// 検証する項目なので、同じ形で尋ね、片方への変更が両方の画面に届くようにします。
//
// 最初に誤りのある項目へフォーカスを置きます。誤りが無ければ名前に置きます。
templ formFields(data FormFieldsData) {
	<div class="grid gap-2">
		<label class="label" for="name">
			{ templates.T(ctx, "oauth_application_form_name_label") }
			@components.RequiredBadge()
		</label>
		<input
			if data.FormErrors == nil || data.FormErrors.HasFieldError("name") {
				autofocus
			}
			class="input"
			id="name"
			name="name"
			required
			type="text"
			value={ data.Name }
			if data.FormErrors != nil && data.FormErrors.HasFieldError("name") {
				aria-invalid="true"
				aria-describedby={ "name-hint " + fieldErrorID("name") }
			} else {
				aria-describedby="name-hint"
			}
		/>
		<p id="name-hint" class="text-muted-foreground text-sm">
			{ templates.T(ctx, "oauth_application_form_name_hint") }
		</p>
		@fieldErrors(data.FormErrors, "name")
	</div>

	<div class="grid gap-2">
		<label class="label" for="redirect_uris">
			{ templates.T(ctx, "oauth_application_form_redirect_uris_label") }
			@components.RequiredBadge()
		</label>
		<textarea
			if data.FormErrors != nil && !data.FormErrors.HasFieldError("name") && data.FormErrors.HasFieldError("redirect_uris") {
				autofocus
			}
			class="textarea font-mono"
			id="redirect_uris"
			name="redirect_uris"
			required
			rows="3"
			spellcheck="false"
			if data.FormErrors != nil && data.FormErrors.HasFieldError("redirect_uris") {
				aria-invalid="true"
				aria-describedby={ "redirect_uris-hint " + fieldErrorID("redirect_uris") }
			} else {
				aria-describedby="redirect_uris-hint"
			}
		>
			{ data.RedirectURIs }
		</textarea>
		<p id="redirect_uris-hint" class="text-muted-foreground text-sm">
			{ templates.T(ctx, "oauth_application_form_redirect_uris_hint") }
		</p>
		@fieldErrors(data.FormErrors, "redirect_uris")
	</div>
}
