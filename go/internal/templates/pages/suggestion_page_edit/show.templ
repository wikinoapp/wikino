package suggestion_page_edit

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// ShowData は編集提案ページ編集の確認画面に渡すデータ構造体です
type ShowData struct {
	CSRFToken           string
	Space               viewmodel.Space
	Topic               viewmodel.Topic
	SuggestionNumber    int32
	SuggestionPageID    string
	SuggestionPageTitle string
}

// Show は編集提案ページ編集の確認画面のコンテンツを表示します
templ Show(data ShowData) {
	<div class="py-4">
		<div class="max-w-3xl w-full mx-auto">
			<div class="flex flex-col gap-6">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "suggestion_page_edit_confirm_heading"),
					})
				</div>

				@components.ContentCard() {
					<div class="flex flex-col gap-4">
						if data.SuggestionPageTitle != "" {
							<ul class="list-disc pl-4">
								<li>
									{ data.SuggestionPageTitle }
								</li>
							</ul>
						}

						<p>
							{ templates.T(ctx, "suggestion_page_edit_confirm_message") }
						</p>

						<div class="flex items-center gap-2">
							<form
								action={ templ.SafeURL(string(templates.SuggestionPageEditsPath(data.Space.Identifier, data.SuggestionNumber))) }
								method="POST"
							>
								<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
								<input type="hidden" name="suggestion_page_id" value={ data.SuggestionPageID }/>
								<input type="hidden" name="force" value="true"/>
								<button
									type="submit"
									class="btn rounded-full w-fit"
								>
									{ templates.T(ctx, "suggestion_page_edit_overwrite_button") }
								</button>
							</form>

							<a
								href={ templ.SafeURL(string(templates.SuggestionChangesPath(data.Space.Identifier, data.SuggestionNumber))) }
								class="btn rounded-full w-fit"
								data-variant="secondary"
							>
								{ templates.T(ctx, "suggestion_page_edit_keep_draft_button") }
							</a>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}
