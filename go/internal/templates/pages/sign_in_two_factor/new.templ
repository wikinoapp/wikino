package sign_in_two_factor

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// NewPageData は2FAコード入力ページに渡すデータ構造体です
type NewPageData struct {
	CSRFToken  string
	FormErrors *model.ValidationError
	BackURL    string
}

// New は2FAコード入力ページのコンテンツを表示します
templ New(data NewPageData) {
	<div class="max-w-lg w-full flex flex-col gap-6">
		<div class="text-center px-4">
			<a href="/" aria-label={ templates.T(ctx, "home_link_aria_label") } class="inline-block">
				<div class="bg-primary rounded-xl">
					@templates.DecorativeIcon("logo", "fill-primary-foreground w-[60px] h-[60px]")
				</div>
			</a>
		</div>

		<div class="flex flex-col gap-2 px-4">
			<h1 class="text-center text-3xl text-primary font-bold antialiased">
				{ templates.T(ctx, "sign_in_two_factor_new_heading") }
			</h1>

			<p class="text-center text-sm text-muted-foreground whitespace-pre-line">
				{ templates.T(ctx, "sign_in_two_factor_new_enter_code") }
			</p>
		</div>

		@components.FormErrorSummary(data.FormErrors)

		@components.ContentCard() {
			<form
				action="/sign_in/two_factor"
				class="grid gap-6"
				hx-on:submit="disableSubmitButtons(this)"
				method="POST"
			>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<input type="hidden" name="back" value={ data.BackURL }/>

				<div class="grid gap-2">
					<label class="label" for="totp_code">
						{ templates.T(ctx, "sign_in_two_factor_new_code_label") }
					</label>

					<input
						if data.FormErrors != nil && data.FormErrors.HasFieldError("totp_code") {
							aria-invalid="true"
						} else {
							aria-invalid="false"
						}
						autocomplete="one-time-code"
						autofocus
						class="input"
						id="totp_code"
						maxlength="6"
						name="totp_code"
						placeholder="000000"
						required
						tabindex="1"
						type="text"
					/>

					<p class="text-sm text-muted-foreground">
						{ templates.T(ctx, "sign_in_two_factor_new_code_hint") }
					</p>

					if data.FormErrors != nil && data.FormErrors.HasFieldError("totp_code") {
						for _, errorMsg := range data.FormErrors.GetFieldErrors("totp_code") {
							<p class="text-sm text-error">{ errorMsg }</p>
						}
					}
				</div>

				<button
					class="btn rounded-full w-fit"
					tabindex="2"
					type="submit"
				>
					@templates.Icon("arrow-right-regular")
					{ templates.T(ctx, "sign_in_two_factor_new_submit_button") }
				</button>
			</form>
		}

		<div class="flex flex-col gap-2 text-sm px-4">
			<p class="text-muted-foreground">
				{ templates.T(ctx, "sign_in_two_factor_new_recovery_description") }
			</p>

			<a href={ templ.SafeURL(string(templates.SignInTwoFactorRecoveryNewPath(data.BackURL))) } class="link-foreground">
				{ templates.T(ctx, "sign_in_two_factor_new_recovery_link") }
			</a>
		</div>

		<div class="text-center px-4">
			<a href="/" class="link-foreground inline-flex items-center gap-1">
				@templates.Icon("arrow-left-regular", "w-4 h-4")
				{ templates.T(ctx, "back_to_home") }
			</a>
		</div>
	</div>
}
