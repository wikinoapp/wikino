package personal_access_token

import (
	"slices"
	"strconv"
	"strings"

	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// defaultExpirationDaysは発行フォームを初めて開いたときに選んでおく有効期限の日数。
const defaultExpirationDays = "30"

// NewDataは個人アクセストークンの発行フォームをレンダリングする元になるデータ。
//
// Name・Scopes・ExpirationDaysは送信された値をフォームへ戻すためのもので、拒否された送信でも
// 入力した内容が残るようにする。ExpirationDaysが空のときはdefaultExpirationDaysを選ぶ。
type NewData struct {
	CSRFToken      string
	Space          viewmodel.Space
	FormErrors     *model.ValidationError
	Name           string
	Scopes         []string
	ExpirationDays string
}

// Newは個人アクセストークンの発行フォームを表示します。
templ New(data NewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title:    templates.T(ctx, "personal_access_token_new_heading"),
						Subtitle: newSubtitle(),
					})
				</div>

				@components.FormErrorSummary(data.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.SpaceSettingsPersonalAccessTokensPath(data.Space.Identifier))) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div class="grid gap-2">
							<label class="label" for="name">
								{ templates.T(ctx, "personal_access_token_new_name_label") }
								@components.RequiredBadge()
							</label>
							<input
								if data.FormErrors == nil || data.FormErrors.HasFieldError("name") {
									autofocus
								}
								class="input"
								id="name"
								name="name"
								required
								type="text"
								value={ data.Name }
								if data.FormErrors != nil && data.FormErrors.HasFieldError("name") {
									aria-invalid="true"
									aria-describedby={ fieldErrorID("name") }
								}
							/>
							<p class="text-muted-foreground text-sm">
								{ templates.T(ctx, "personal_access_token_new_name_hint") }
							</p>
							@fieldErrors(data.FormErrors, "name")
						</div>

						// 選択肢のグループはトピックの公開範囲と同じく、basecoatの .fieldsetでまとめます。
						<fieldset class="fieldset gap-3">
							<legend class="label">
								{ templates.T(ctx, "personal_access_token_new_scopes_label") }
								@components.RequiredBadge()
							</legend>
							@fieldErrors(data.FormErrors, "scopes")
							for _, scope := range model.APITokenScopes {
								<div class="flex flex-col gap-1">
									<label class="label flex items-center gap-2 cursor-pointer" for={ scopeInputID(scope) }>
										<input
											class="input"
											id={ scopeInputID(scope) }
											name="scopes"
											type="checkbox"
											value={ string(scope) }
											if data.FormErrors != nil && !data.FormErrors.HasFieldError("name") && data.FormErrors.HasFieldError("scopes") && scope == model.APITokenScopes[0] {
												autofocus
											}
											if hasValue(data.Scopes, string(scope)) {
												checked
											}
											if data.FormErrors != nil && data.FormErrors.HasFieldError("scopes") {
												aria-invalid="true"
												aria-describedby={ fieldErrorID("scopes") }
											}
										/>
										{ components.APITokenScopeLabel(ctx, scope) }
									</label>
									<p class="text-muted-foreground pl-[25px] text-sm">
										{ components.APITokenScopeHint(ctx, scope) }
									</p>
								</div>
							}
						</fieldset>

						<div class="grid gap-2">
							<label class="label" for="expiration_days">
								{ templates.T(ctx, "personal_access_token_new_expiration_days_label") }
								@components.RequiredBadge()
							</label>
							<select
								class="select w-fit"
								id="expiration_days"
								name="expiration_days"
								required
								if data.FormErrors != nil && !data.FormErrors.HasFieldError("name") && !data.FormErrors.HasFieldError("scopes") && data.FormErrors.HasFieldError("expiration_days") {
									autofocus
								}
								if data.FormErrors != nil && data.FormErrors.HasFieldError("expiration_days") {
									aria-invalid="true"
									aria-describedby={ fieldErrorID("expiration_days") }
								}
							>
								for _, days := range model.PersonalAccessTokenExpirationDays {
									<option
										value={ strconv.Itoa(days) }
										if strconv.Itoa(days) == selectedExpirationDays(data.ExpirationDays) {
											selected
										}
									>
										{ templates.T(ctx, "personal_access_token_new_expiration_days_option", map[string]any{"Days": days}) }
									</option>
								}
							</select>
							@fieldErrors(data.FormErrors, "expiration_days")
						</div>

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("paper-plane-tilt-regular")
								{ templates.T(ctx, "personal_access_token_new_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.SpaceSettingsPersonalAccessTokensPath(data.Space.Identifier))) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "personal_access_token_new_cancel") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}

// newSubtitleは発行フォームのサブタイトルを表示します。
templ newSubtitle() {
	{ templates.T(ctx, "personal_access_token_new_description") }
}

// fieldErrorsはフォームの1つの項目のエラーを表示します。項目が1つのaria-describedbyで
// すべてのエラーを指せるよう、エラーは1つの要素にまとめます。
templ fieldErrors(formErrors *model.ValidationError, field string) {
	if formErrors != nil && formErrors.HasFieldError(field) {
		<div id={ fieldErrorID(field) }>
			for _, errorMsg := range formErrors.GetFieldErrors(field) {
				<p class="text-sm text-error">
					{ errorMsg }
				</p>
			}
		</div>
	}
}

// fieldErrorIDはフォームの1つの項目のエラーを収める要素のidを返します。
func fieldErrorID(field string) string {
	return field + "-error"
}

// scopeInputIDはスコープのチェックボックスのidを返します。
func scopeInputID(scope model.Scope) string {
	return "scopes_" + strings.ReplaceAll(string(scope), ":", "_")
}

// selectedExpirationDaysは有効期限の選択肢のうち選んでおく値を返します。
func selectedExpirationDays(value string) string {
	if value == "" {
		return defaultExpirationDays
	}
	return value
}

// hasValueは送信された値の中にvalueがあるかを返します。
func hasValue(values []string, value string) bool {
	return slices.Contains(values, value)
}
