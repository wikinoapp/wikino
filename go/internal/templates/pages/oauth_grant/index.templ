package oauth_grant

import (
	"context"

	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// IndexDataは連携中のアプリの一覧の画面をレンダリングする元になるデータ。
//
// Grantsは閲覧者自身が許可した失効していない連携である。CanDeleteは連携を解除できるか
// (oauth_grant:delete) を表し、偽なら解除のボタンを出さない。
type IndexData struct {
	CSRFToken string
	Space     viewmodel.Space
	Grants    []viewmodel.OAuthGrant
	CanDelete bool
}

// Indexは連携中のアプリの一覧の画面を表示します。
templ Index(data IndexData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title:    templates.T(ctx, "oauth_grant_index_heading"),
						Subtitle: indexSubtitle(),
					})
				</div>
				if len(data.Grants) == 0 {
					<div class="px-4">
						@components.EmptyState(components.EmptyStateData{
							Message:  templates.T(ctx, "oauth_grant_index_empty"),
							IconName: "lock-regular",
						})
					</div>
				} else {
					@components.ContentCard() {
						<ul class="flex flex-col divide-y">
							for _, grant := range data.Grants {
								<li class="flex flex-col gap-2 py-3 first:pt-0 last:pb-0">
									@grantItem(grant)
									if data.CanDelete {
										@revokeForm(data.CSRFToken, data.Space.Identifier, grant)
									}
								</li>
							}
						</ul>
					}
				}
			</div>
		</div>
	</div>
}

// indexSubtitleは一覧の画面のサブタイトルを表示します。
templ indexSubtitle() {
	{ templates.T(ctx, "oauth_grant_index_description") }
}

// grantItemは一覧の1件の連携を表示します。
//
// 同じアプリの連携は端末ごとに並ぶため、アプリ名の隣に端末名を出して見分けられるようにする。
// 端末名はクライアントが申告した値で、送られなかった連携では出さない。CIMDのクライアントは名前を
// 自分で名乗るため、クライアントIDのホスト名を添える。
templ grantItem(grant viewmodel.OAuthGrant) {
	<div class="flex flex-wrap items-baseline gap-x-2">
		<span id={ grantNameID(grant) } class="font-bold [overflow-wrap:anywhere]">{ grant.ApplicationName }</span>
		if grant.ApplicationHost != "" {
			<span class="text-sm text-muted-foreground [overflow-wrap:anywhere]">
				{ templates.T(ctx, "oauth_grant_index_application_host", map[string]any{"Host": grant.ApplicationHost}) }
			</span>
		}
		if grant.DeviceName != "" {
			<span id={ deviceNameID(grant) } class="text-sm text-muted-foreground [overflow-wrap:anywhere]">{ grant.DeviceName }</span>
		}
	</div>
	@components.APITokenScopeBadges(grant.Scopes)
	<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm text-muted-foreground">
		<dt>{ templates.T(ctx, "oauth_grant_index_created_at") }</dt>
		<dd id={ createdAtID(grant) }>
			@components.AbsoluteTime(components.AbsoluteTimeData{Time: grant.CreatedAt})
		</dd>
		<dt>{ templates.T(ctx, "oauth_grant_index_last_used_at") }</dt>
		<dd>
			if grant.LastUsedAt != nil {
				@components.RelativeTime(components.RelativeTimeData{Time: *grant.LastUsedAt})
			} else {
				{ templates.T(ctx, "oauth_grant_index_never_used") }
			}
		</dd>
	</dl>
}

// revokeFormは連携を解除するボタンを表示します。解除は取り消せないため、送信の前に確認します。
//
// 一覧には連携ごとに同じ文言のボタンが並ぶため、ボタンの名前にアプリ名と端末名 (無ければ連携した
// 日時) を連ねる。同じアプリの連携が端末ごとに並んでも、スクリーンリーダーでボタンだけを取り出したときに
// どの連携のボタンか区別できるようにするためである。見えている文言を名前の先頭に置き、音声操作でも
// その文言で指定できるようにする。確認の文言にも同じく端末名か連携した日時を含める。
templ revokeForm(csrfToken string, spaceIdentifier viewmodel.SpaceIdentifier, grant viewmodel.OAuthGrant) {
	<form
		action={ templ.SafeURL(string(templates.SpaceSettingsOAuthGrantPath(spaceIdentifier, grant.ID))) }
		data-confirm={ revokeConfirm(ctx, grant) }
		hx-on:submit="if (!confirm(this.dataset.confirm)) { event.preventDefault(); return false; }"
		method="POST"
	>
		<input type="hidden" name="_method" value="DELETE"/>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button
			aria-labelledby={ revokeLabelID(grant) + " " + grantNameID(grant) + " " + grantDistinctionID(grant) }
			class="btn h-fit p-0 text-error"
			data-variant="link"
			data-size="sm"
			type="submit"
		>
			@templates.Icon("trash-regular", "size-3")
			<span id={ revokeLabelID(grant) }>{ templates.T(ctx, "oauth_grant_index_revoke") }</span>
		</button>
	</form>
}

// grantNameIDは一覧の1件の連携のアプリ名を収める要素のidを返します。
func grantNameID(grant viewmodel.OAuthGrant) string {
	return "oauth-grant-" + grant.ID + "-name"
}

// deviceNameIDは一覧の1件の連携の端末名を収める要素のidを返します。
func deviceNameID(grant viewmodel.OAuthGrant) string {
	return "oauth-grant-" + grant.ID + "-device-name"
}

// createdAtIDは一覧の1件の連携の連携した日時を収める要素のidを返します。
func createdAtID(grant viewmodel.OAuthGrant) string {
	return "oauth-grant-" + grant.ID + "-created-at"
}

// grantDistinctionIDは、同じアプリの連携どうしを見分ける要素 (端末名、無ければ連携した日時) のidを返します。
func grantDistinctionID(grant viewmodel.OAuthGrant) string {
	if grant.DeviceName != "" {
		return deviceNameID(grant)
	}
	return createdAtID(grant)
}

// revokeConfirmは連携の解除の確認の文言を返します。端末名があれば端末名で、無ければ連携した日時で
// どの連携かを示します。
func revokeConfirm(ctx context.Context, grant viewmodel.OAuthGrant) string {
	if grant.DeviceName != "" {
		return templates.T(ctx, "oauth_grant_index_revoke_confirm_with_device_name", map[string]any{"Name": grant.ApplicationName, "DeviceName": grant.DeviceName})
	}
	return templates.T(ctx, "oauth_grant_index_revoke_confirm", map[string]any{"Name": grant.ApplicationName, "CreatedAt": templates.FormatDateTime(ctx, grant.CreatedAt)})
}

// revokeLabelIDは連携を解除するボタンの文言を収める要素のidを返します。
func revokeLabelID(grant viewmodel.OAuthGrant) string {
	return "oauth-grant-" + grant.ID + "-revoke-label"
}
