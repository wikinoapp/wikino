package home

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// ShowPageData はホーム画面に渡すデータ構造体です
type ShowPageData struct {
	ActiveSpaces []viewmodel.Space
}

// Show はホーム画面のコンテンツを表示します
templ Show(data ShowPageData) {
	<div class="py-4">
		<div class="flex flex-col gap-4">
			@components.TopNav(components.TopNavData{
				MaxWidthClass: "max-w-3xl",
			})

			<div class="max-w-3xl w-full mx-auto">
				<div class="flex flex-col gap-6">
					<div class="px-4">
						@components.MainTitle(components.MainTitleData{
							Title: templates.T(ctx, "home_heading"),
						})
					</div>

					<div class="flex flex-col gap-4 px-4">
						<div class="flex items-center justify-between gap-4">
							<h2 class="font-bold antialiased">
								{ templates.T(ctx, "home_joined_spaces_heading") }
							</h2>

							<a href="/spaces/new" class="btn-sm rounded-full">
								@templates.Icon("plus-regular", "size-4 fill-primary-foreground")
								{ templates.T(ctx, "home_new_space_button") }
							</a>
						</div>

						if len(data.ActiveSpaces) == 0 {
							@emptyState()
						} else {
							<div class="grid grid-cols-2 gap-2 md:grid-cols-4">
								for _, space := range data.ActiveSpaces {
									@spaceCard(space)
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

// spaceCard は参加中スペースのカードを表示します
templ spaceCard(space viewmodel.Space) {
	<a href={ templ.SafeURL(string(templates.SpacePath(space.Identifier))) } class="card py-4 rounded-xl hover:bg-muted/40 transition-colors">
		<section class="px-4">
			<div class="line-clamp-3 text-sm font-bold">
				{ space.Name }
			</div>
		</section>
	</a>
}

// emptyState は参加中スペースが 0 件のときの空状態を表示します
templ emptyState() {
	<div class="card py-8 rounded-xl">
		<div class="flex flex-col items-center justify-center gap-4 px-4 text-center text-muted-foreground">
			@templates.Icon("file-regular", "size-10 fill-muted-foreground")
			<p class="font-bold antialiased">
				@templ.Raw(templates.T(ctx, "home_no_joined_spaces_html"))
			</p>
			<div class="text-sm">
				@templ.Raw(templates.T(ctx, "home_new_space_description_html"))
			</div>
		</div>
	</div>
}
