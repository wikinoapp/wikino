package settings

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// 各項目の補足を収める要素のid
const (
	atnameHintID      = "atname-hint"
	nameHintID        = "name-hint"
	descriptionHintID = "description-hint"
)

// ProfileDataはプロフィールの編集画面をレンダリングする元になるデータ。
//
// Atname・Name・Descriptionは、初めて開いたときは保存されている値を、拒否された送信では
// 送信された値を持ち、入力した内容が残るようにする。
type ProfileData struct {
	CSRFToken   string
	FormErrors  *model.ValidationError
	Atname      string
	Name        string
	Description string
}

// Profileはプロフィールの編集画面のコンテンツを表示します。
//
// 最初に誤りのある項目へフォーカスを置きます。誤りが無いときはどこにも置きません。保存されて
// いる値を確かめに開くことも多い画面のため、開いただけで入力の状態にしないためです。
templ Profile(data ProfileData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "settings_profile_show_heading"),
					})
				</div>

				@components.FormErrorSummary(data.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.SettingsProfilePath())) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="_method" value="PATCH"/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div class="grid gap-2">
							<label class="label" for="atname">
								{ templates.T(ctx, "settings_profile_show_atname_label") }
								@components.RequiredBadge()
							</label>
							// アットネームはURLに使う英数字のため、モバイルの自動大文字化とスペルチェックを止める
							// 通常時の枠線をライトでも見分けられるようにし、エラーとフォーカス中はBasecoatの色を使う
							<input
								autocapitalize="off"
								if firstErrorField(data.FormErrors) == "atname" {
									autofocus
								}
								class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input"
								id="atname"
								name="atname"
								required
								spellcheck="false"
								type="text"
								value={ data.Atname }
								aria-describedby={ describedBy(data.FormErrors, "atname", atnameHintID) }
								if hasFieldError(data.FormErrors, "atname") {
									aria-invalid="true"
								}
							/>
							<p id={ atnameHintID } class="text-muted-foreground text-sm">
								{ templates.T(ctx, "settings_profile_show_atname_hint") }
							</p>
							@fieldErrors(data.FormErrors, "atname")
						</div>

						<div class="grid gap-2">
							@components.OptionalLabel(components.OptionalLabelData{
								For:   "name",
								Label: templates.T(ctx, "settings_profile_show_name_label"),
							})
							<input
								autocomplete="name"
								if firstErrorField(data.FormErrors) == "name" {
									autofocus
								}
								class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input"
								id="name"
								name="name"
								type="text"
								value={ data.Name }
								aria-describedby={ describedBy(data.FormErrors, "name", nameHintID) }
								if hasFieldError(data.FormErrors, "name") {
									aria-invalid="true"
								}
							/>
							<p id={ nameHintID } class="text-muted-foreground text-sm">
								{ templates.T(ctx, "settings_profile_show_name_hint") }
							</p>
							@fieldErrors(data.FormErrors, "name")
						</div>

						<div class="grid gap-2">
							@components.OptionalLabel(components.OptionalLabelData{
								For:   "description",
								Label: templates.T(ctx, "settings_profile_show_description_label"),
							})
							<input
								if firstErrorField(data.FormErrors) == "description" {
									autofocus
								}
								class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input"
								id="description"
								name="description"
								type="text"
								value={ data.Description }
								aria-describedby={ describedBy(data.FormErrors, "description", descriptionHintID) }
								if hasFieldError(data.FormErrors, "description") {
									aria-invalid="true"
								}
							/>
							<p id={ descriptionHintID } class="text-muted-foreground text-sm">
								{ templates.T(ctx, "settings_profile_show_description_hint") }
							</p>
							@fieldErrors(data.FormErrors, "description")
						</div>

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("paper-plane-tilt-regular")
								{ templates.T(ctx, "settings_profile_show_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.SettingsPath())) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "settings_profile_show_cancel") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}

// profileFieldsはフォームの項目を画面の上からの順に並べたもの
var profileFields = []string{"atname", "name", "description"}

// firstErrorFieldは画面の上から見て最初に誤りのある項目を返します。誤りが無ければ空を返します。
func firstErrorField(formErrors *model.ValidationError) string {
	for _, field := range profileFields {
		if hasFieldError(formErrors, field) {
			return field
		}
	}
	return ""
}

func hasFieldError(formErrors *model.ValidationError, field string) bool {
	return formErrors != nil && formErrors.HasFieldError(field)
}

// describedByは項目の補足と、誤りがあればそのエラーを指すaria-describedbyの値を返します。
func describedBy(formErrors *model.ValidationError, field, hintID string) string {
	if hasFieldError(formErrors, field) {
		return hintID + " " + fieldErrorID(field)
	}
	return hintID
}

// fieldErrorsはフォームの1つの項目のエラーを表示します。項目が1つのaria-describedbyで
// すべてのエラーを指せるよう、エラーは1つの要素にまとめます。
templ fieldErrors(formErrors *model.ValidationError, field string) {
	if hasFieldError(formErrors, field) {
		<div id={ fieldErrorID(field) }>
			for _, errorMsg := range formErrors.GetFieldErrors(field) {
				<p class="text-sm text-error">
					{ errorMsg }
				</p>
			}
		</div>
	}
}

// fieldErrorIDはフォームの1つの項目のエラーを収める要素のidを返します。
func fieldErrorID(field string) string {
	return field + "-error"
}
