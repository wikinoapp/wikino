package settings

import (
	"time"

	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// twoFactorAuthHelpURLはヘルプ「二要素認証を設定する」のURL。ヘルプは日本語だけのため、表示言語によらず同じページへリンクする。
const twoFactorAuthHelpURL = "https://wikino.app/s/wikino/pages/55"

// TwoFactorAuthDataは二要素認証の設定の画面をレンダリングする元になるデータ
type TwoFactorAuthData struct {
	Enabled bool
	// EnabledAtは有効にした日時。有効でないとき、またはRails版で日時を残していないときはnil
	EnabledAt *time.Time
}

// TwoFactorAuthは二要素認証の設定の画面のコンテンツを表示します。
//
// 有効なときは有効にした日時とリカバリーコードへのリンクを、無効なときは有効にする画面への入口を出します。
templ TwoFactorAuth(data TwoFactorAuthData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4 flex flex-col gap-2">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "settings_two_factor_auth_show_heading"),
					})
					<p class="text-sm text-stone-600 dark:text-stone-300">
						{ templates.T(ctx, "settings_two_factor_auth_show_description") }
						<a href={ templ.SafeURL(twoFactorAuthHelpURL) } class="link-foreground" target="_blank">
							{ templates.T(ctx, "settings_two_factor_auth_show_help_link") }
						</a>
					</p>
				</div>

				@components.ContentCard() {
					if data.Enabled {
						<div class="grid gap-6">
							<div class="flex flex-col gap-2">
								<p class="flex items-center gap-2 font-semibold text-green-700 dark:text-green-400">
									@templates.Icon("check-circle-regular", "size-6 fill-current")
									{ templates.T(ctx, "settings_two_factor_auth_show_status_enabled") }
								</p>
								if data.EnabledAt != nil {
									<p class="text-sm text-stone-600 dark:text-stone-300">
										{ templates.T(ctx, "settings_two_factor_auth_show_enabled_at", map[string]any{"Time": templates.FormatDateTime(ctx, *data.EnabledAt)}) }
									</p>
								}
							</div>

							<div>
								<a
									href={ templ.SafeURL(string(templates.SettingsTwoFactorAuthRecoveryCodesPath())) }
									class="btn rounded-full w-fit"
								>
									{ templates.T(ctx, "settings_two_factor_auth_show_recovery_codes") }
								</a>
							</div>
						</div>
					} else {
						<div class="grid gap-6">
							<p>{ templates.T(ctx, "settings_two_factor_auth_show_status_disabled") }</p>

							<div class="flex justify-between gap-2">
								<a
									href={ templ.SafeURL(string(templates.NewSettingsTwoFactorAuthPath())) }
									class="btn rounded-full w-fit"
								>
									{ templates.T(ctx, "settings_two_factor_auth_show_enable") }
								</a>

								<a
									href={ templ.SafeURL(string(templates.SettingsPath())) }
									class="btn rounded-full w-fit"
									data-variant="outline"
								>
									{ templates.T(ctx, "settings_two_factor_auth_show_back") }
								</a>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
}
