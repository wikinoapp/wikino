package settings

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// codeHintIDは確認コードの補足を収める要素のid
const codeHintID = "code-hint"

// EmailConfirmationDataは、メールアドレスの変更の確認コードを入力する画面をレンダリングする元になるデータ
type EmailConfirmationData struct {
	CSRFToken  string
	FormErrors *model.ValidationError
}

// EmailConfirmationは、メールアドレスの変更の確認コードを入力する画面のコンテンツを表示します。
//
// 入力した確認コードは送り返しません。誤っていたコードを残しても入力し直すだけになるためです。
templ EmailConfirmation(data EmailConfirmationData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4 flex flex-col gap-2">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "settings_email_confirmation_edit_heading"),
					})
					<p class="text-sm text-stone-600 dark:text-stone-300">
						{ templates.T(ctx, "settings_email_confirmation_edit_description") }
					</p>
				</div>

				@components.FormErrorSummary(data.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.SettingsEmailConfirmationPath())) }
						class="grid gap-6"
						data-disable-on-submit
						method="POST"
					>
						<input type="hidden" name="_method" value="PATCH"/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div class="grid gap-2">
							<label class="label" for="code">
								{ templates.T(ctx, "settings_email_confirmation_edit_code_label") }
								@components.RequiredBadge()
							</label>
							// 確認コードは大文字の英数字のため、モバイルでは大文字で入力させ、スペルチェックを止める
							<input
								autocapitalize="characters"
								autocomplete="one-time-code"
								autofocus
								class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input focus-visible:border-primary focus-visible:ring-primary aria-invalid:focus-visible:border-destructive aria-invalid:focus-visible:ring-destructive"
								id="code"
								maxlength="6"
								name="code"
								required
								spellcheck="false"
								type="text"
								aria-describedby={ describedBy(data.FormErrors, "code", codeHintID) }
								if hasFieldError(data.FormErrors, "code") {
									aria-invalid="true"
								}
							/>
							<p id={ codeHintID } class="text-muted-foreground text-sm">
								{ templates.T(ctx, "settings_email_confirmation_edit_code_hint") }
							</p>
							@fieldErrors(data.FormErrors, "code")
						</div>

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("check-regular")
								{ templates.T(ctx, "settings_email_confirmation_edit_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.SettingsEmailPath())) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "settings_email_confirmation_edit_back") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}
