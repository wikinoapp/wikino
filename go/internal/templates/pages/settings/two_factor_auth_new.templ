package settings

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/qrcode"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
)

// 二要素認証を有効にするフォームの各項目の補足を収める要素のid
const (
	twoFactorAuthPasswordHintID = "two-factor-auth-password-hint"
	totpCodeHintID              = "totp-code-hint"
)

// twoFactorAuthNewFieldsは二要素認証を有効にするフォームの項目を画面の上からの順に並べたもの
var twoFactorAuthNewFields = []string{"password", "totp_code"}

// TwoFactorAuthNewDataは、二要素認証を有効にするため認証アプリへ登録する画面をレンダリングする元になるデータ。
//
// 入力したパスワードと認証アプリのコードは送り返さない。コードは30秒ごとに変わり、残しても入力し直すことになるため。
type TwoFactorAuthNewData struct {
	CSRFToken  string
	FormErrors *model.ValidationError
	// Secretは認証アプリへ手で入力してもらう、base32の秘密鍵
	Secret string
	// QRCodeは秘密鍵を登録するotpauth URIのQRコード
	QRCode *qrcode.Code
}

// TwoFactorAuthNewは、認証アプリへ登録する秘密鍵と、二要素認証を有効にするフォームを表示します。
//
// 最初に開いたときは手順とQRコードを読んでもらうためフォーカスを動かさず、誤りがあれば最初に誤りのある項目に置きます。
templ TwoFactorAuthNew(data TwoFactorAuthNewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4 flex flex-col gap-2">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "settings_two_factor_auth_new_heading"),
					})
					<p class="text-sm text-stone-600 dark:text-stone-300">
						{ templates.T(ctx, "settings_two_factor_auth_new_description") }
						<a href={ templ.SafeURL(twoFactorAuthHelpURL) } class="link-foreground" target="_blank">
							{ templates.T(ctx, "settings_two_factor_auth_new_help_link") }
						</a>
					</p>
				</div>

				@components.FormErrorSummary(data.FormErrors)

				@components.ContentCard() {
					<div class="grid gap-6">
						<ol class="grid gap-6">
							<li>{ templates.T(ctx, "settings_two_factor_auth_new_step_install") }</li>
							<li class="grid gap-3">
								<p>{ templates.T(ctx, "settings_two_factor_auth_new_step_scan") }</p>
								// ダークでも読み取れるよう、配色によらず白地に黒のモジュールで描く
								<svg
									aria-label={ templates.T(ctx, "settings_two_factor_auth_new_qr_code_label") }
									class="size-48 shrink-0 rounded-lg border border-stone-300 bg-white dark:border-stone-600"
									role="img"
									shape-rendering="crispEdges"
									viewBox={ data.QRCode.ViewBox() }
									xmlns="http://www.w3.org/2000/svg"
								>
									<path fill="#000" d={ data.QRCode.Path }></path>
								</svg>
								<div class="grid gap-2">
									<p class="text-sm text-stone-600 dark:text-stone-300">
										{ templates.T(ctx, "settings_two_factor_auth_new_manual_entry") }
									</p>
									<code class="w-fit rounded border border-stone-300 px-2 py-1 font-mono break-all dark:border-stone-600">
										{ data.Secret }
									</code>
								</div>
							</li>
							<li>{ templates.T(ctx, "settings_two_factor_auth_new_step_enter") }</li>
						</ol>

						<form
							action={ templ.SafeURL(string(templates.SettingsTwoFactorAuthPath())) }
							class="grid gap-6"
							data-disable-on-submit
							method="POST"
						>
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

							<div class="grid gap-2">
								<label class="label" for="password">
									{ templates.T(ctx, "settings_two_factor_auth_new_password_label") }
									@components.RequiredBadge()
								</label>
								<input
									autocomplete="current-password"
									if firstErrorField(data.FormErrors, twoFactorAuthNewFields) == "password" {
										autofocus
									}
									class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input focus-visible:border-primary focus-visible:ring-primary aria-invalid:focus-visible:border-destructive aria-invalid:focus-visible:ring-destructive"
									id="password"
									name="password"
									required
									type="password"
									aria-describedby={ describedBy(data.FormErrors, "password", twoFactorAuthPasswordHintID) }
									if hasFieldError(data.FormErrors, "password") {
										aria-invalid="true"
									}
								/>
								<p id={ twoFactorAuthPasswordHintID } class="text-sm text-stone-600 dark:text-stone-300">
									{ templates.T(ctx, "settings_two_factor_auth_new_password_hint") }
								</p>
								@fieldErrors(data.FormErrors, "password")
							</div>

							<div class="grid gap-2">
								<label class="label" for="totp_code">
									{ templates.T(ctx, "settings_two_factor_auth_new_totp_code_label") }
									@components.RequiredBadge()
								</label>
								<input
									autocomplete="one-time-code"
									if firstErrorField(data.FormErrors, twoFactorAuthNewFields) == "totp_code" {
										autofocus
									}
									class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input focus-visible:border-primary focus-visible:ring-primary aria-invalid:focus-visible:border-destructive aria-invalid:focus-visible:ring-destructive"
									id="totp_code"
									inputmode="numeric"
									maxlength="6"
									name="totp_code"
									required
									spellcheck="false"
									type="text"
									aria-describedby={ describedBy(data.FormErrors, "totp_code", totpCodeHintID) }
									if hasFieldError(data.FormErrors, "totp_code") {
										aria-invalid="true"
									}
								/>
								<p id={ totpCodeHintID } class="text-sm text-stone-600 dark:text-stone-300">
									{ templates.T(ctx, "settings_two_factor_auth_new_totp_code_hint") }
								</p>
								@fieldErrors(data.FormErrors, "totp_code")
							</div>

							<div class="flex justify-between gap-2">
								<button type="submit" class="btn rounded-full w-fit">
									@templates.Icon("check-regular")
									{ templates.T(ctx, "settings_two_factor_auth_new_submit_button") }
								</button>

								<a
									href={ templ.SafeURL(string(templates.SettingsTwoFactorAuthPath())) }
									class="btn rounded-full w-fit"
									data-variant="outline"
								>
									{ templates.T(ctx, "settings_two_factor_auth_new_cancel") }
								</a>
							</div>
						</form>
					</div>
				}
			</div>
		</div>
	</div>
}
