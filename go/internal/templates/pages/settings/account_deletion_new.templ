package settings

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// accountDeletionAtnameHintIDは、アカウントの削除のアットネームの入力欄の説明を収める要素のid
const accountDeletionAtnameHintID = "atname-hint"

// AccountDeletionNewDataはアカウントの削除の確認画面をレンダリングする元になるデータ。
//
// UserAtnameは削除するアカウント (閲覧者本人) のアットネームで、確認のために入力させる値として示す。
// Atnameは送信された値をフォームへ戻すためのもので、拒否された送信でも入力した内容が残るようにする。
// ActiveSpacesが1つでもあれば削除できないため、フォームの代わりにその一覧を出す。
type AccountDeletionNewData struct {
	CSRFToken    string
	UserAtname   string
	Atname       string
	ActiveSpaces []viewmodel.Space
	FormErrors   *model.ValidationError
}

// AccountDeletionNewはアカウントの削除の確認画面のコンテンツを表示します。削除は元に戻せないため、
// 失うものを示したうえで、本人のアットネームを入力させます。
templ AccountDeletionNew(data AccountDeletionNewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "settings_account_deletion_new_heading"),
					})
				</div>

				if data.FormErrors != nil && len(data.FormErrors.Global) > 0 {
					<div
						autofocus
						class="rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						tabindex="-1"
					>
						@components.FormErrorSummary(data.FormErrors)
					</div>
				}

				@components.ContentCard() {
					if len(data.ActiveSpaces) > 0 {
						@accountDeletionBlocked(data.ActiveSpaces)
					} else {
						@accountDeletionForm(data)
					}
				}
			</div>
		</div>
	</div>
}

// accountDeletionFormは、削除する前の注意と、アットネームを入力して削除するフォームを表示します。
templ accountDeletionForm(data AccountDeletionNewData) {
	<div class="flex flex-col gap-4">
		<p>{ templates.T(ctx, "settings_account_deletion_new_description") }</p>
		<ul class="list-inside list-disc">
			<li>{ templates.T(ctx, "settings_account_deletion_new_warning_irreversible") }</li>
			<li>{ templates.T(ctx, "settings_account_deletion_new_warning_atname") }</li>
		</ul>
		<form
			action={ templ.SafeURL(string(templates.SettingsAccountDeletionPath())) }
			class="grid gap-6"
			data-confirm={ templates.T(ctx, "settings_account_deletion_new_confirm") }
			data-disable-on-submit
			method="POST"
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="grid gap-2">
				<label class="label" for="atname">
					{ templates.T(ctx, "settings_account_deletion_new_atname_label") }
					@components.RequiredBadge()
				</label>
				<p class="text-sm text-stone-600 dark:text-stone-300" id={ accountDeletionAtnameHintID }>
					{ templates.T(ctx, "settings_account_deletion_new_atname_hint", map[string]any{"Atname": data.UserAtname}) }
				</p>
				<input
					autocapitalize="none"
					autocomplete="off"
					class="input not-aria-invalid:not-focus-visible:border-stone-500 dark:not-aria-invalid:not-focus-visible:border-input focus-visible:border-primary focus-visible:ring-primary aria-invalid:focus-visible:border-destructive aria-invalid:focus-visible:ring-destructive"
					id="atname"
					name="atname"
					required
					spellcheck="false"
					type="text"
					value={ data.Atname }
					aria-describedby={ describedBy(data.FormErrors, "atname", accountDeletionAtnameHintID) }
					if hasFieldError(data.FormErrors, "atname") {
						aria-invalid="true"
					}
					if hasFieldError(data.FormErrors, "atname") && len(data.FormErrors.Global) == 0 {
						autofocus
					}
				/>
				@fieldErrors(data.FormErrors, "atname")
			</div>
			<div class="flex justify-between gap-2">
				<button
					type="submit"
					class="btn rounded-full w-fit text-red-800 focus-visible:border-red-800 focus-visible:ring-red-800 dark:text-destructive dark:focus-visible:border-destructive dark:focus-visible:ring-destructive"
					data-variant="destructive"
				>
					@templates.Icon("trash-regular")
					{ templates.T(ctx, "settings_account_deletion_new_submit_button") }
				</button>
				<a
					href={ templ.SafeURL(string(templates.SettingsPath())) }
					class="btn rounded-full w-fit"
					data-variant="outline"
				>
					{ templates.T(ctx, "settings_account_deletion_new_cancel") }
				</a>
			</div>
		</form>
	</div>
}

// accountDeletionBlockedは、参加しているスペースがあり削除できない理由と、そのスペースの一覧を表示します。
templ accountDeletionBlocked(spaces []viewmodel.Space) {
	<div class="flex flex-col gap-4">
		<div class="alert">
			@templates.DecorativeIcon("warning-regular", "fill-warning")
			<h2>{ templates.T(ctx, "settings_account_deletion_new_cannot_delete_heading") }</h2>
			<section>
				{ templates.T(ctx, "settings_account_deletion_new_cannot_delete_description") }
			</section>
		</div>
		<ul class="list-inside list-disc" aria-label={ templates.T(ctx, "settings_account_deletion_new_spaces_label") }>
			for _, space := range spaces {
				<li>
					<a class="underline underline-offset-4" href={ templ.SafeURL(string(templates.SpacePath(space.Identifier))) }>
						{ space.Name }
					</a>
				</li>
			}
		</ul>
		<a
			href={ templ.SafeURL(string(templates.SettingsPath())) }
			class="btn rounded-full w-fit"
			data-variant="outline"
		>
			{ templates.T(ctx, "settings_account_deletion_new_back") }
		</a>
	</div>
}
