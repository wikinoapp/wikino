package space

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// DeletionNewDataはスペースの削除の確認画面をレンダリングする元になるデータ。SpaceNameは
// 送信された値をフォームへ戻すためのもので、拒否された送信でも入力した内容が残るようにする。
type DeletionNewData struct {
	CSRFToken  string
	Space      viewmodel.Space
	SpaceName  string
	FormErrors *model.ValidationError
}

// DeletionNewはスペースの削除の確認画面のコンテンツを表示します。削除は元に戻せないため、
// 失うものを示したうえで、削除するスペースの名前を入力させます。
templ DeletionNew(data DeletionNewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "space_deletion_new_heading"),
					})
				</div>
				@components.FormErrorSummary(data.FormErrors, "space_name")
				@components.ContentCard() {
					<div class="flex flex-col gap-4">
						<p>{ templates.T(ctx, "space_deletion_new_description") }</p>
						<ul class="list-inside list-disc">
							<li>{ templates.T(ctx, "space_deletion_new_warning_contents") }</li>
							<li>{ templates.T(ctx, "space_deletion_new_warning_irreversible") }</li>
						</ul>
						<form
							action={ templ.SafeURL(string(templates.SpaceSettingsDeletionPath(data.Space.Identifier))) }
							class="grid gap-6"
							method="POST"
						>
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
							<div class="grid gap-2">
								<label class="label" for="space_name">
									{ templates.T(ctx, "space_deletion_new_space_name_label") }
									@components.RequiredBadge()
								</label>
								<p class="text-sm text-muted-foreground" id="space_name-hint">
									{ templates.T(ctx, "space_deletion_new_space_name_hint", map[string]any{"SpaceName": data.Space.Name}) }
								</p>
								<input
									autocomplete="off"
									class="input border-muted-foreground focus-visible:ring-muted-foreground aria-invalid:border-destructive"
									id="space_name"
									name="space_name"
									required
									type="text"
									value={ data.SpaceName }
									if data.FormErrors != nil && data.FormErrors.HasFieldError("space_name") {
										autofocus
										aria-invalid="true"
										aria-describedby={ "space_name-hint " + fieldErrorID("space_name") }
									} else {
										aria-describedby="space_name-hint"
									}
								/>
								@fieldErrors(data.FormErrors, "space_name")
							</div>
							<div class="flex justify-between gap-2">
								<button type="submit" class="btn rounded-full w-fit">
									@templates.Icon("trash-regular")
									{ templates.T(ctx, "space_deletion_new_submit_button") }
								</button>
								<a
									href={ templ.SafeURL(string(templates.SpaceSettingsPath(data.Space.Identifier))) }
									class="btn rounded-full w-fit"
									data-variant="outline"
								>
									{ templates.T(ctx, "space_deletion_new_cancel") }
								</a>
							</div>
						</form>
					</div>
				}
			</div>
		</div>
	</div>
}
