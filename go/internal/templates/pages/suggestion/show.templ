package suggestion

import (
	"context"
	"fmt"

	"github.com/wikinoapp/wikino/go/internal/i18n"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// ShowData は編集提案詳細画面に渡すデータ構造体です
type ShowData struct {
	CSRFToken                  string
	Space                      viewmodel.Space
	Topic                      viewmodel.Topic
	Suggestion                 viewmodel.SuggestionForDetail
	Comments                   []viewmodel.SuggestionCommentForList
	SuggestionPages            []viewmodel.SuggestionPageForList
	IsSpaceMember              bool
	CanApply                   bool
	CanClose                   bool
	CanUpdateSuggestion        bool
	CanUpdateSuggestionComment bool
}

// Show は編集提案詳細画面のコンテンツを表示します
templ Show(data ShowData) {
	<div class="py-4">
		<div class="flex flex-col gap-4">
			@components.TopNav(components.TopNavData{
				MaxWidthClass: "max-w-3xl",
				Items: []components.BreadcrumbItem{
					{
						Path:      templates.HomePath(),
						IconName:  "house-regular",
						AriaLabel: templates.T(ctx, "breadcrumb_home"),
					},
					{
						Label:    data.Space.Name,
						Path:     templates.SpacePath(data.Space.Identifier.String()),
						IconName: "globe-regular",
					},
					{
						Label:    data.Topic.Name,
						Path:     templates.TopicPath(data.Space.Identifier.String(), data.Topic.Number),
						IconName: data.Topic.IconName,
					},
					{
						Label: templates.T(ctx, "suggestion_show_breadcrumb"),
						Path:  templates.SuggestionListPath(data.Space.Identifier.String(), data.Topic.Number),
					},
				},
			})

			<div class="max-w-3xl w-full mx-auto">
				<div class="flex flex-col gap-6">
					<div class="flex flex-col gap-4">
						<div class="px-4">
							@components.MainTitle(components.MainTitleData{
								Title:   data.Suggestion.Title,
								Content: components.SuggestionTitleContent(data.Suggestion.Status, data.Suggestion.Number),
								Actions: showActions(data),
							})
						</div>

						<div class="px-0 md:px-4">
							@components.SubNav([]components.SubNavItem{
								{
									Label:          templates.T(ctx, "suggestion_show_conversation_tab"),
									Path:           string(templates.SuggestionShowPath(data.Space.Identifier.String(), data.Suggestion.Number)),
									IconName:       "chats-circle-regular",
									ActiveIconName: "chats-circle-fill",
									IsActive:       true,
								},
								{
									Label:          templates.T(ctx, "suggestion_show_changed_pages_tab"),
									Path:           string(templates.SuggestionChangesPath(data.Space.Identifier.String(), data.Suggestion.Number)),
									IconName:       "files-regular",
									ActiveIconName: "files-fill",
									Badge:          fmt.Sprintf("%d", len(data.SuggestionPages)),
								},
							})
						</div>
					</div>

					@components.Post(components.PostData{
						CreatorAtname: data.Suggestion.CreatorAtname,
						BodyHTML:      data.Suggestion.BodyHTML,
						CreatedAt:     data.Suggestion.CreatedAt,
					})

					<div class="flex flex-col gap-2">
						<div class="px-4">
							<h2 class="text-md font-bold antialiased">
								{ templates.T(ctx, "suggestion_show_comments_heading") }
							</h2>
						</div>

						<div class="flex flex-col gap-4">
							if len(data.Comments) > 0 {
								@showComments(data)
							}

							if data.IsSpaceMember {
								@components.ContentCard() {
									@showCommentForm(data)
								}
							}
						</div>
					</div>

					if data.CanApply || data.CanClose {
						<div class="px-0 md:px-4">
							<hr class="border-border border-dashed">
						</div>

						@components.ContentCard() {
							<div class="flex flex-col gap-4">
								<p class="text-sm text-muted-foreground">
									{ templates.T(ctx, "suggestion_show_action_description") }
								</p>

								<div class="flex items-center gap-2">
									if data.CanApply {
										@showApplyForm(data)
									}
									if data.CanClose {
										@showCloseForm(data)
									}
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// showActions は編集提案詳細画面のアクションボタンを表示します
templ showActions(data ShowData) {
	if data.CanUpdateSuggestion {
		<a
			href={ templ.SafeURL(string(templates.SuggestionEditPath(data.Space.Identifier.String(), data.Suggestion.Number))) }
			class="btn btn-sm rounded-full"
		>
			@templates.Icon("pencil-simple-line-regular", "size-[18px] fill-primary-foreground")
			{ templates.T(ctx, "suggestion_show_edit_button") }
		</a>
	}
}

// showComments はコメント一覧を表示します
templ showComments(data ShowData) {
	<div class="flex flex-col gap-4">
		for _, c := range data.Comments {
			@components.Post(components.PostData{
				CreatorAtname: c.CreatorAtname,
				BodyHTML:      c.BodyHTML,
				CreatedAt:     c.CreatedAt,
				Actions:       commentActions(ctx, data, c),
				DropdownID:    fmt.Sprintf("comment-%d", c.Number),
			})
		}
	</div>
}

// showApplyForm は反映ボタンを表示します
templ showApplyForm(data ShowData) {
	<form
		action={ templ.SafeURL(string(templates.SuggestionApplyPath(data.Space.Identifier.String(), data.Suggestion.Number))) }
		method="POST"
	>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		<button
			class="btn-primary rounded-full w-fit"
			type="submit"
		>
			@templates.Icon("git-merge-regular")
			{ templates.T(ctx, "suggestion_apply_button") }
		</button>
	</form>
}

// showCloseForm はクローズボタンを表示します
templ showCloseForm(data ShowData) {
	<form
		action={ templ.SafeURL(string(templates.SuggestionClosePath(data.Space.Identifier.String(), data.Suggestion.Number))) }
		method="POST"
	>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		<button
			class="btn-secondary rounded-full w-fit"
			type="submit"
		>
			{ templates.T(ctx, "suggestion_close_button") }
		</button>
	</form>
}

// commentActions はコメントのドロップダウンメニューに表示するアクション一覧を返します
func commentActions(ctx context.Context, data ShowData, c viewmodel.SuggestionCommentForList) []components.PostAction {
	if !data.CanUpdateSuggestionComment {
		return nil
	}
	return []components.PostAction{
		{
			Label: i18n.T(ctx, "suggestion_comment_edit_action"),
			URL:   string(templates.SuggestionCommentEditPath(data.Space.Identifier.String(), data.Suggestion.Number, c.Number)),
		},
	}
}

// showCommentForm はコメント入力フォームを表示します
templ showCommentForm(data ShowData) {
	<form
		action={ templ.SafeURL(string(templates.SuggestionCommentsPath(data.Space.Identifier.String(), data.Suggestion.Number))) }
		class="form grid gap-4"
		method="POST"
	>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

		<div class="grid gap-2">
			<textarea
				class="textarea"
				id="comment_body"
				name="body"
				placeholder={ templates.T(ctx, "suggestion_comment_body_placeholder") }
				rows="4"
			></textarea>
		</div>

		<button
			class="btn-primary rounded-full w-fit"
			type="submit"
		>
			@templates.Icon("paper-plane-tilt-regular")
			{ templates.T(ctx, "suggestion_comment_submit") }
		</button>
	</form>
}
