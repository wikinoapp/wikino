package suggestion

import (
	"fmt"

	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// ShowData は編集提案詳細画面に渡すデータ構造体です
type ShowData struct {
	CSRFToken       string
	Space           viewmodel.Space
	Topic           viewmodel.Topic
	Suggestion      viewmodel.SuggestionForDetail
	Comments        []viewmodel.SuggestionCommentForList
	SuggestionPages []viewmodel.SuggestionPageForList
	IsSpaceMember   bool
}

// Show は編集提案詳細画面のコンテンツを表示します
templ Show(data ShowData) {
	<div class="py-4">
		<div class="flex flex-col gap-4">
			@components.TopNav(components.TopNavData{
				MaxWidthClass: "max-w-3xl",
				Items: []components.BreadcrumbItem{
					{
						Path:      templates.HomePath(),
						IconName:  "house-regular",
						AriaLabel: templates.T(ctx, "breadcrumb_home"),
					},
					{
						Label:    data.Space.Name,
						Path:     templates.SpacePath(data.Space.Identifier.String()),
						IconName: "globe-regular",
					},
					{
						Label:    data.Topic.Name,
						Path:     templates.TopicPath(data.Space.Identifier.String(), data.Topic.Number),
						IconName: data.Topic.IconName,
					},
					{
						Label: templates.T(ctx, "suggestion_show_breadcrumb"),
						Path:  templates.SuggestionListPath(data.Space.Identifier.String(), data.Topic.Number),
					},
					{
						Label: fmt.Sprintf("#%d", data.Suggestion.Number),
					},
				},
			})

			<div class="max-w-3xl w-full mx-auto">
				<div class="flex flex-col gap-6">
					<div class="px-4">
						<div class="flex flex-col gap-2">
							<h1 class="text-xl font-bold">
								{ data.Suggestion.Title }
							</h1>
							<div class="flex items-center gap-2 text-sm text-muted-foreground">
								@showStatusBadge(data.Suggestion.Status)
								<span>
									{ fmt.Sprintf("#%d", data.Suggestion.Number) }
								</span>
								<span>
									{ data.Suggestion.CreatorName }
								</span>
							</div>
						</div>
					</div>

					<div class="px-4">
						@showTabs(data)
					</div>

					if data.Suggestion.BodyHTML != "" {
						<div class="px-4">
							<div class="prose prose-sm max-w-none">
								@templ.Raw(data.Suggestion.BodyHTML)
							</div>
						</div>
					}

					if len(data.Comments) > 0 {
						<div class="px-4">
							@showComments(data)
						</div>
					}

					if data.IsSpaceMember {
						<div class="px-4">
							@showCommentForm(data)
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// showStatusBadge はステータスに応じたバッジを表示します
templ showStatusBadge(status model.SuggestionStatus) {
	switch status {
		case model.SuggestionStatusDraft:
			<span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">
				{ templates.T(ctx, "suggestion_show_status_draft") }
			</span>
		case model.SuggestionStatusOpen:
			<span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800 dark:bg-green-900 dark:text-green-200">
				@templates.Icon("git-pull-request-regular", "size-3")
				{ templates.T(ctx, "suggestion_show_status_open") }
			</span>
		case model.SuggestionStatusApplied:
			<span class="inline-flex items-center gap-1 rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-semibold text-purple-800 dark:bg-purple-900 dark:text-purple-200">
				@templates.Icon("check-regular", "size-3")
				{ templates.T(ctx, "suggestion_show_status_applied") }
			</span>
		case model.SuggestionStatusClosed:
			<span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-800 dark:bg-red-900 dark:text-red-200">
				@templates.Icon("xmark-regular", "size-3")
				{ templates.T(ctx, "suggestion_show_status_closed") }
			</span>
	}
}

// showTabs は「会話」「編集したページ」のタブを表示します
templ showTabs(data ShowData) {
	<div class="flex gap-4 border-b border-border">
		<span class="flex items-center gap-1.5 px-2 py-2 text-sm font-semibold border-b-2 border-foreground">
			@templates.Icon("comment-regular", "size-4")
			{ templates.T(ctx, "suggestion_show_conversation_tab") }
		</span>
		<span class="flex items-center gap-1.5 px-2 py-2 text-sm text-muted-foreground">
			@templates.Icon("file-lines-regular", "size-4")
			{ templates.T(ctx, "suggestion_show_changed_pages_tab") }
			<span class="text-xs">
				{ fmt.Sprintf("%d", len(data.SuggestionPages)) }
			</span>
		</span>
	</div>
}

// showComments はコメント一覧を表示します
templ showComments(data ShowData) {
	<div class="flex flex-col divide-y divide-border">
		for _, c := range data.Comments {
			<div class="flex flex-col gap-2 py-4">
				<div class="flex items-center gap-2 text-sm font-semibold">
					{ c.CreatorName }
				</div>
				<div class="prose prose-sm max-w-none">
					@templ.Raw(c.BodyHTML)
				</div>
			</div>
		}
	</div>
}

// showCommentForm はコメント入力フォームを表示します
templ showCommentForm(data ShowData) {
	<form method="POST" action={ templ.SafeURL(string(templates.SuggestionCommentsPath(data.Space.Identifier.String(), data.Suggestion.Number))) }>
		<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
		<div class="flex flex-col gap-3">
			<label for="comment_body" class="text-sm font-semibold">
				{ templates.T(ctx, "suggestion_comment_body_label") }
			</label>
			<textarea
				id="comment_body"
				name="body"
				rows="4"
				class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				placeholder={ templates.T(ctx, "suggestion_comment_body_placeholder") }
			></textarea>
			<div class="flex justify-end">
				<button type="submit" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-9 px-4 py-2">
					{ templates.T(ctx, "suggestion_comment_submit") }
				</button>
			</div>
		</div>
	</form>
}
