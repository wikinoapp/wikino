package suggestion

import (
	"fmt"

	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// EditData は編集提案編集画面に渡すデータ構造体です
type EditData struct {
	CSRFToken  string
	FormErrors *model.ValidationError
	Space      viewmodel.Space
	Topic      viewmodel.Topic
	Suggestion viewmodel.SuggestionForDetail
	Title      string
	Body       string
}

// Edit は編集提案編集画面のコンテンツを表示します
templ Edit(data EditData) {
	<div class="py-4">
		<div class="flex flex-col gap-4">
			@components.TopNav(components.TopNavData{
				MaxWidthClass: "max-w-3xl",
				Items: []components.BreadcrumbItem{
					{
						Path:      templates.HomePath(),
						IconName:  "house-regular",
						AriaLabel: templates.T(ctx, "breadcrumb_home"),
					},
					{
						Label:    data.Space.Name,
						Path:     templates.SpacePath(data.Space.Identifier.String()),
						IconName: "globe-regular",
					},
					{
						Label:    data.Topic.Name,
						Path:     templates.TopicPath(data.Space.Identifier.String(), data.Topic.Number),
						IconName: data.Topic.IconName,
					},
					{
						Label: fmt.Sprintf("%s #%d", templates.T(ctx, "suggestion_show_breadcrumb"), data.Suggestion.Number),
						Path:  templates.SuggestionShowPath(data.Space.Identifier.String(), data.Suggestion.Number),
					},
				},
			})

			<div class="max-w-3xl w-full mx-auto">
				<div class="flex flex-col gap-6">
					<div class="px-4">
						@components.MainTitle(components.MainTitleData{
							Title: templates.T(ctx, "suggestion_edit_heading"),
						})
					</div>

					@components.FormErrors(data.FormErrors)

					@components.ContentCard() {
						<form
							action={ templ.SafeURL(string(templates.SuggestionShowPath(data.Space.Identifier.String(), data.Suggestion.Number))) }
							class="form grid gap-6"
							method="POST"
						>
							<input type="hidden" name="_method" value="PATCH"/>
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

							<div class="grid gap-2">
								<label for="title">
									{ templates.T(ctx, "suggestion_edit_title_label") }
								</label>

								<input
									if data.FormErrors != nil && data.FormErrors.HasFieldError("title") {
										aria-invalid="true"
									} else {
										aria-invalid="false"
									}
									autofocus
									id="title"
									name="title"
									placeholder={ templates.T(ctx, "suggestion_edit_title_placeholder") }
									type="text"
									value={ data.Title }
								/>

								if data.FormErrors != nil && data.FormErrors.HasFieldError("title") {
									for _, errMsg := range data.FormErrors.GetFieldErrors("title") {
										<p class="text-sm text-destructive">{ errMsg }</p>
									}
								}
							</div>

							<div class="grid gap-2">
								<label for="body">
									{ templates.T(ctx, "suggestion_edit_body_label") }
								</label>

								<textarea
									if data.FormErrors != nil && data.FormErrors.HasFieldError("body") {
										aria-invalid="true"
									} else {
										aria-invalid="false"
									}
									id="body"
									name="body"
									placeholder={ templates.T(ctx, "suggestion_edit_body_placeholder") }
									rows="8"
								>
									{ data.Body }
								</textarea>

								if data.FormErrors != nil && data.FormErrors.HasFieldError("body") {
									for _, errMsg := range data.FormErrors.GetFieldErrors("body") {
										<p class="text-sm text-destructive">{ errMsg }</p>
									}
								}
							</div>

							<div class="flex justify-between gap-2">
								<button
									class="btn rounded-full w-fit"
									type="submit"
								>
									@templates.Icon("floppy-disk-regular")
									{ templates.T(ctx, "suggestion_edit_submit") }
								</button>

								<a
									class="btn-outline rounded-full w-fit"
									href={ templ.SafeURL(string(templates.SuggestionShowPath(data.Space.Identifier.String(), data.Suggestion.Number))) }
								>
									{ templates.T(ctx, "suggestion_edit_cancel") }
								</a>
							</div>
						</form>
					}
				</div>
			</div>
		</div>
	</div>
}
