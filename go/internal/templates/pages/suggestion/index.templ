package suggestion

import (
	"fmt"

	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// IndexData は編集提案一覧画面に渡すデータ構造体です
type IndexData struct {
	Space       viewmodel.Space
	Topic       viewmodel.Topic
	Suggestions []viewmodel.SuggestionForList
	OpenCount   int64
	ClosedCount int64
	ShowClosed  bool
}

// suggestionsPath は編集提案一覧のパスを生成します
func (d IndexData) suggestionsPath(tab string) string {
	base := string(templates.SuggestionListPath(d.Space.Identifier.String(), d.Topic.Number))
	if tab == "" {
		return base
	}
	return base + "?tab=" + tab
}

// Index は編集提案一覧画面のコンテンツを表示します
templ Index(data IndexData) {
	<div class="py-4">
		<div class="flex flex-col gap-4">
			@components.TopNav(components.TopNavData{
				MaxWidthClass: "max-w-3xl",
				Items: []components.BreadcrumbItem{
					{
						Path:      templates.HomePath(),
						IconName:  "house-regular",
						AriaLabel: templates.T(ctx, "breadcrumb_home"),
					},
					{
						Label:    data.Space.Name,
						Path:     templates.SpacePath(data.Space.Identifier.String()),
						IconName: "globe-regular",
					},
					{
						Label:    data.Topic.Name,
						Path:     templates.TopicPath(data.Space.Identifier.String(), data.Topic.Number),
						IconName: data.Topic.IconName,
					},
					{
						Label: templates.T(ctx, "suggestion_index_breadcrumb"),
					},
				},
			})

			<div class="max-w-3xl w-full mx-auto">
				<div class="flex flex-col gap-6">
					<div class="px-4">
						@components.MainTitle(components.MainTitleData{
							Title: templates.T(ctx, "suggestion_index_heading"),
						})
					</div>

					<div class="px-4">
						@indexTabs(data)
					</div>

					if len(data.Suggestions) > 0 {
						<div class="px-4">
							@indexList(data)
						</div>
					} else {
						<div class="px-4">
							@indexEmptyState(data)
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// indexTabs はオープン/クローズのタブ切り替えを表示します
templ indexTabs(data IndexData) {
	<div class="flex gap-4 border-b border-border">
		if !data.ShowClosed {
			<a
				href={ templ.SafeURL(data.suggestionsPath("")) }
				class="flex items-center gap-1.5 px-2 py-2 text-sm font-semibold border-b-2 border-foreground"
			>
				@templates.Icon("git-pull-request-regular", "size-4")
				{ fmt.Sprintf("%d", data.OpenCount) }
				{ templates.T(ctx, "suggestion_index_open_tab") }
			</a>
			<a
				href={ templ.SafeURL(data.suggestionsPath("closed")) }
				class="flex items-center gap-1.5 px-2 py-2 text-sm text-muted-foreground hover:text-foreground"
			>
				@templates.Icon("check-regular", "size-4")
				{ fmt.Sprintf("%d", data.ClosedCount) }
				{ templates.T(ctx, "suggestion_index_closed_tab") }
			</a>
		} else {
			<a
				href={ templ.SafeURL(data.suggestionsPath("")) }
				class="flex items-center gap-1.5 px-2 py-2 text-sm text-muted-foreground hover:text-foreground"
			>
				@templates.Icon("git-pull-request-regular", "size-4")
				{ fmt.Sprintf("%d", data.OpenCount) }
				{ templates.T(ctx, "suggestion_index_open_tab") }
			</a>
			<a
				href={ templ.SafeURL(data.suggestionsPath("closed")) }
				class="flex items-center gap-1.5 px-2 py-2 text-sm font-semibold border-b-2 border-foreground"
			>
				@templates.Icon("check-regular", "size-4")
				{ fmt.Sprintf("%d", data.ClosedCount) }
				{ templates.T(ctx, "suggestion_index_closed_tab") }
			</a>
		}
	</div>
}

// indexList は編集提案のリストを表示します
templ indexList(data IndexData) {
	<div class="flex flex-col divide-y divide-border">
		for _, s := range data.Suggestions {
			<a
				href={ templ.SafeURL(string(templates.SuggestionShowPath(data.Space.Identifier.String(), s.Number))) }
				class="flex flex-col gap-1 py-3 hover:bg-muted/50 -mx-2 px-2 rounded-md"
			>
				<div class="font-semibold">
					{ s.Title }
				</div>
				<div class="text-sm text-muted-foreground">
					{ fmt.Sprintf("#%d", s.Number) }
					{ templates.T(ctx, "suggestion_index_opened_by") }
					{ s.CreatorName }
				</div>
			</a>
		}
	</div>
}

// indexEmptyState は編集提案がない場合の空状態を表示します
templ indexEmptyState(data IndexData) {
	<div class="flex flex-col items-center gap-4 py-12 text-center">
		@templates.Icon("git-pull-request-regular", "size-[50px] fill-muted-foreground")

		<div class="flex flex-col gap-2">
			<h2 class="text-lg font-bold">
				if data.ShowClosed {
					{ templates.T(ctx, "suggestion_index_no_closed") }
				} else {
					{ templates.T(ctx, "suggestion_index_no_open") }
				}
			</h2>
		</div>
	</div>
}
