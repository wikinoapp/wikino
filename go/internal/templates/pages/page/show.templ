package page

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// ShowData is the data passed to the page detail screen.
//
// [Ja] ShowData はページ表示画面に渡すデータ構造体です。
type ShowData struct {
	Page  viewmodel.PageForShow
	Space viewmodel.Space

	// IsTrashed reports that the page sits in the trash. The usecase only ever renders this screen
	// for a viewer allowed to see a trashed page, so the alert can be shown whenever it is true.
	//
	// [Ja] IsTrashed はページがゴミ箱に入っていることを表す。UseCase はゴミ箱のページを見てよい
	// 閲覧者にしか本画面を描画させないため、true ならそのままアラートを出してよい。
	IsTrashed bool

	// CanUpdatePage reports that the viewer may edit this page, and gates the edit button in the
	// header.
	//
	// [Ja] CanUpdatePage は閲覧者がこのページを編集できるかを表し、ヘッダーの編集ボタンの出し分けに
	// 使う。
	CanUpdatePage bool

	// LinkList and BacklinkList are the listings rendered under the body. Each holds the selected
	// slice: htmx appends later slices, while a full-page fallback renders the slice named by the URL.
	//
	// [Ja] LinkList と BacklinkList は本文の下に描画する一覧。各一覧は選択された範囲を保持し、htmx は
	// 後続の範囲を追記する。フルページフォールバックでは URL が指す範囲を描画する。
	LinkList     viewmodel.LinkList
	BacklinkList viewmodel.BacklinkList
}

// Show renders the page detail screen content.
//
// [Ja] Show はページ表示画面のコンテンツを表示します。
templ Show(data ShowData) {
	<div class="py-4">
		<div class="max-w-3xl w-full mx-auto">
			<div class="flex flex-col gap-6 px-4">
				<article class="flex flex-col gap-6">
					if data.IsTrashed {
						@trashedAlert(data.Space.Identifier)
					}

					@components.MainTitle(components.MainTitleData{
						Title:   data.Page.DisplayTitle(ctx),
						Actions: showHeaderActions(data),
					})

					if data.Page.BodyHTML != "" {
						// The body HTML is sanitized when the page is published, so expand it raw here.
						//
						// [Ja] 本文 HTML はページ公開時にサニタイズ済みのため、ここでは生のまま展開する。
						<div class="wikino-markdown">
							@templ.Raw(data.Page.BodyHTML)
						</div>
					}
				</article>

				@showFooter(data)
			</div>
		</div>
	</div>
}

// showHeaderActions renders the header's action area, and returns nil when the viewer has nothing
// to act on so that MainTitle leaves the area out entirely.
//
// [Ja] showHeaderActions はヘッダーの操作領域を描画し、閲覧者に操作するものが無い場合は nil を返して
// MainTitle 側で領域ごと省かせる。
func showHeaderActions(data ShowData) templ.Component {
	if !data.CanUpdatePage {
		return nil
	}
	return showEditButton(data)
}

// showEditButton links to the editor of the page being shown.
//
// [Ja] showEditButton は表示中のページの編集画面へのリンクを出す。
templ showEditButton(data ShowData) {
	<a
		class="btn btn-sm rounded-full"
		href={ templ.SafeURL(string(templates.PageEditPath(data.Space.Identifier, data.Page.Number))) }
	>
		@templates.DecorativeIcon("pencil-simple-line-regular", "size-[18px] fill-primary-foreground")
		{ templates.T(ctx, "page_show_edit_button") }
	</a>
}

// showFooter renders the link list and the backlink list under the body. Each section is dropped
// when its listing is empty, so a page with no links shows no headings at all.
//
// [Ja] showFooter は本文の下にリンク一覧とバックリンク一覧を描画する。一覧が空のセクションは丸ごと
// 落とすため、リンクを持たないページでは見出しも出ない。
templ showFooter(data ShowData) {
	if len(data.LinkList.Items) > 0 || len(data.BacklinkList.Items) > 0 {
		<div class="flex flex-col gap-6">
			if len(data.LinkList.Items) > 0 {
				<div class="flex flex-col gap-4">
					<h2 class="text-2xl/8 font-bold antialiased">
						{ templates.T(ctx, "page_show_links_heading") }
					</h2>

					@components.LinkList(data.LinkList)
				</div>
			}

			if len(data.BacklinkList.Items) > 0 {
				<div class="flex flex-col gap-4">
					<h2 class="text-2xl/8 font-bold antialiased">
						{ templates.T(ctx, "page_show_backlinks_heading") }
					</h2>

					@components.PageBacklinkList(data.BacklinkList)
				</div>
			}
		</div>
	}
}

// trashedAlert tells a viewer holding the trash permission that this page is in the trash, and
// links to the trash screen so they can restore it.
//
// [Ja] trashedAlert はゴミ箱権限を持つ閲覧者に、このページがゴミ箱に入っていることを伝え、
// 復元できるようゴミ箱画面へのリンクを出す。
templ trashedAlert(spaceIdentifier viewmodel.SpaceIdentifier) {
	<div class="alert">
		@templates.DecorativeIcon("warning-circle-regular", "fill-info")
		// The alert title is a status message, not a section of the page, and it precedes the page's
		// h1. A heading element here would put a phantom entry ahead of the h1 in the outline, so use
		// strong: the alert styles its title with :is(h2, ..., strong, [data-title]), which keeps the
		// appearance identical.
		//
		// [Ja] アラートの見出しはページのセクションではなく状態メッセージで、しかもページの h1 より
		// 前に出る。見出し要素にするとアウトライン上に h1 より前の幽霊項目ができるため strong を使う。
		// アラートは :is(h2, ..., strong, [data-title]) で見出しを装飾するため見た目は変わらない。
		<strong>
			{ templates.T(ctx, "page_show_trashed_alert") }

			<a href={ templ.SafeURL(string(templates.TrashPath(spaceIdentifier))) } class="underline">
				{ templates.T(ctx, "page_show_view_trash_link") }
			</a>
		</strong>
	</div>
}
