package suggestion_page

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// NewData は編集提案ページ追加画面に渡すデータ構造体です
type NewData struct {
	CSRFToken        string
	FormErrors       *model.ValidationError
	Space            viewmodel.Space
	Topic            viewmodel.Topic
	Suggestion       viewmodel.SuggestionForDetail
	DraftPages       []viewmodel.DraftPageForSuggestionNew
}

// New は編集提案ページ追加画面のコンテンツを表示します
templ New(data NewData) {
	<div class="py-4">
		<div class="max-w-3xl w-full mx-auto">
			<div class="flex flex-col gap-6">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "suggestion_page_new_heading"),
					})
				</div>

				@components.FormErrors(data.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.SuggestionPagesPath(data.Space.Identifier, data.Suggestion.Number))) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div
							class="grid gap-2"
							role="group"
							aria-labelledby="draft-page-ids-label"
						>
							<span id="draft-page-ids-label" class="label">
								{ templates.T(ctx, "suggestion_page_new_draft_pages_label") }
							</span>

							if data.FormErrors != nil && data.FormErrors.HasFieldError("draft_page_ids") {
								for _, errMsg := range data.FormErrors.GetFieldErrors("draft_page_ids") {
									<p class="text-sm text-destructive">{ errMsg }</p>
								}
							}

							if len(data.DraftPages) > 0 {
								<div class="flex flex-col gap-2 border border-border rounded-lg p-4">
									for _, dp := range data.DraftPages {
										<label class="label flex items-center gap-3 cursor-pointer">
											<input
												type="checkbox"
												name="draft_page_ids"
												value={ string(dp.ID) }
												class="input"
											/>

											<span class="text-sm">
												{ dp.DisplayTitle(ctx) }
											</span>
										</label>
									}
								</div>
							} else {
								<p class="text-sm text-muted-foreground">
									{ templates.T(ctx, "suggestion_page_new_no_draft_pages") }
								</p>
							}
						</div>

						<div class="flex justify-between gap-2">
							<button
								type="submit"
								class="btn rounded-full w-fit"
								if len(data.DraftPages) == 0 {
									disabled
								}
							>
								@templates.Icon("file-plus-regular", "size-4")
								{ templates.T(ctx, "suggestion_page_new_submit") }
							</button>

							<a
								class="btn rounded-full w-fit"
								data-variant="outline"
								href={ templ.SafeURL(string(templates.SuggestionChangesPath(data.Space.Identifier, data.Suggestion.Number))) }
							>
								{ templates.T(ctx, "suggestion_page_new_cancel") }
							</a>
						</div>
					</form>
				}

			</div>
		</div>
	</div>
}
