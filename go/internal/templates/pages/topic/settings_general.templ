package topic

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// SettingsGeneralData is what the general settings screen of a topic is rendered with.
//
// [Ja] SettingsGeneralData はトピックの一般設定画面をレンダリングする元になるデータ。
type SettingsGeneralData struct {
	CSRFToken string
	Space     viewmodel.Space
	Topic     viewmodel.Topic
	Fields    FormFieldsData
}

// SettingsGeneral はトピックの一般設定画面のコンテンツを表示します
templ SettingsGeneral(data SettingsGeneralData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title: templates.T(ctx, "topic_settings_general_heading"),
					})
				</div>

				@components.FormErrorSummary(data.Fields.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.TopicSettingsGeneralPath(data.Space.Identifier, data.Topic.Number))) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="_method" value="PATCH"/>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						@formFields(data.Fields)

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("paper-plane-tilt-regular")
								{ templates.T(ctx, "topic_settings_general_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.TopicSettingsPath(data.Space.Identifier, data.Topic.Number))) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "topic_settings_general_cancel") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}
