package topic

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// NewData is what the topic creation screen is rendered with. Name, Description and Visibility
// carry the submitted values back into the form, so a rejected submission keeps what was typed.
//
// [Ja] NewData はトピック作成画面をレンダリングする元になるデータ。Name・Description・Visibility は
// 送信された値をフォームへ戻すためのもので、拒否された送信でも入力した内容が残るようにする。
type NewData struct {
	CSRFToken   string
	FormErrors  *model.ValidationError
	Space       viewmodel.Space
	Name        string
	Description string
	Visibility  string
}

// New はトピック作成画面のコンテンツを表示します
templ New(data NewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title:    templates.T(ctx, "topic_new_heading"),
						Subtitle: hintSubtitle(),
					})
				</div>

				@components.FormErrorSummary(data.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.TopicListPath(data.Space.Identifier))) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div class="grid gap-2">
							<label class="label" for="name">
								{ templates.T(ctx, "topic_new_name_label") }
							</label>

							<input
								autofocus
								class="input"
								id="name"
								name="name"
								required
								type="text"
								value={ data.Name }
								if data.FormErrors != nil && data.FormErrors.HasFieldError("name") {
									aria-invalid="true"
									aria-describedby={ fieldErrorID("name") }
								}
							/>

							@fieldErrors(data.FormErrors, "name")
						</div>

						<div class="grid gap-2">
							@components.OptionalLabel(components.OptionalLabelData{
								For:   "description",
								Label: templates.T(ctx, "topic_new_description_label"),
							})

							<input
								class="input"
								id="description"
								name="description"
								type="text"
								value={ data.Description }
								if data.FormErrors != nil && data.FormErrors.HasFieldError("description") {
									aria-invalid="true"
									aria-describedby={ fieldErrorID("description") }
								}
							/>

							@fieldErrors(data.FormErrors, "description")
						</div>

						<fieldset class="grid gap-3">
							<legend class="label">
								{ templates.T(ctx, "topic_new_visibility_label") }
							</legend>

							@fieldErrors(data.FormErrors, "visibility")

							<div class="flex flex-col gap-2">
								<label class="label flex items-center gap-2 cursor-pointer" for="visibility_public">
									<input
										class="input"
										id="visibility_public"
										name="visibility"
										type="radio"
										value={ model.TopicVisibilityPublic.String() }
										if data.Visibility == model.TopicVisibilityPublic.String() {
											checked
										}
										if data.FormErrors != nil && data.FormErrors.HasFieldError("visibility") {
											aria-invalid="true"
											aria-describedby={ fieldErrorID("visibility") }
										}
									/>

									<span class="flex items-center gap-1">
										@templates.DecorativeIcon("globe-regular", "size-4")
										{ templates.T(ctx, "topic_new_visibility_public") }
									</span>
								</label>

								<p class="text-muted-foreground pl-[25px] text-sm">
									{ templates.T(ctx, "topic_new_visibility_public_hint") }
								</p>
							</div>

							<div class="flex flex-col gap-2">
								<label class="label flex items-center gap-2 cursor-pointer" for="visibility_private">
									<input
										class="input"
										id="visibility_private"
										name="visibility"
										type="radio"
										value={ model.TopicVisibilityPrivate.String() }
										if data.Visibility == model.TopicVisibilityPrivate.String() {
											checked
										}
										if data.FormErrors != nil && data.FormErrors.HasFieldError("visibility") {
											aria-invalid="true"
											aria-describedby={ fieldErrorID("visibility") }
										}
									/>

									<span class="flex items-center gap-1">
										@templates.DecorativeIcon("lock-regular", "size-4")
										{ templates.T(ctx, "topic_new_visibility_private") }
									</span>
								</label>

								<div class="text-muted-foreground pl-[25px] text-sm">
									<p>
										{ templates.T(ctx, "topic_new_visibility_private_hint") }
									</p>

									<p class="font-bold">
										@templ.Raw(templates.T(ctx, "topic_new_visibility_private_note_html"))
									</p>
								</div>
							</div>
						</fieldset>

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("paper-plane-tilt-regular")
								{ templates.T(ctx, "topic_new_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.SpacePath(data.Space.Identifier))) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "topic_new_cancel") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}

// hintSubtitle renders the subtitle of the topic creation screen, which carries links to the help
// pages.
//
// [Ja] hintSubtitle はトピック作成画面のサブタイトルを表示します。ヘルプページへのリンクを
// 含みます。
templ hintSubtitle() {
	@templ.Raw(templates.T(ctx, "topic_new_hint_html"))
}

// fieldErrors renders the errors of one form field. They sit in one element so that the field can
// point at all of them with a single aria-describedby.
//
// Only the inputs point at this element. A group of inputs does not have its fieldset point at it
// as well, which would make a screen reader announce the same errors on entering the group and
// again on every option in it.
//
// [Ja] fieldErrors はフォームの 1 つの項目のエラーを表示します。項目が 1 つの aria-describedby で
// すべてのエラーを指せるよう、エラーは 1 つの要素にまとめます。
//
// この要素を指すのは入力欄だけです。入力欄のグループでは、それを囲む fieldset からは指しません。
// 指すと、スクリーンリーダーがグループに入るときと、その中の選択肢ごとの両方で同じエラーを
// 読み上げることになります。
templ fieldErrors(formErrors *model.ValidationError, field string) {
	if formErrors != nil && formErrors.HasFieldError(field) {
		<div id={ fieldErrorID(field) }>
			for _, errorMsg := range formErrors.GetFieldErrors(field) {
				<p class="text-sm text-error">
					{ errorMsg }
				</p>
			}
		</div>
	}
}

// fieldErrorID names the element that holds the errors of one form field.
//
// [Ja] fieldErrorID はフォームの 1 つの項目のエラーを収める要素の id を返します。
func fieldErrorID(field string) string {
	return field + "-error"
}
