package topic

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// NewData is what the topic creation screen is rendered with.
//
// [Ja] NewData はトピック作成画面をレンダリングする元になるデータ。
type NewData struct {
	CSRFToken string
	Space     viewmodel.Space
	Fields    FormFieldsData
}

// New はトピック作成画面のコンテンツを表示します
templ New(data NewData) {
	<div class="py-4">
		<div class="max-w-2xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title:    templates.T(ctx, "topic_new_heading"),
						Subtitle: hintSubtitle(),
					})
				</div>

				@components.FormErrorSummary(data.Fields.FormErrors)

				@components.ContentCard() {
					<form
						action={ templ.SafeURL(string(templates.TopicListPath(data.Space.Identifier))) }
						class="grid gap-6"
						method="POST"
					>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						@formFields(data.Fields)

						<div class="flex justify-between gap-2">
							<button type="submit" class="btn rounded-full w-fit">
								@templates.Icon("paper-plane-tilt-regular")
								{ templates.T(ctx, "topic_new_submit_button") }
							</button>

							<a
								href={ templ.SafeURL(string(templates.SpacePath(data.Space.Identifier))) }
								class="btn rounded-full w-fit"
								data-variant="outline"
							>
								{ templates.T(ctx, "topic_new_cancel") }
							</a>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
}

// hintSubtitle renders the subtitle of the topic creation screen, which carries links to the help
// pages.
//
// [Ja] hintSubtitle はトピック作成画面のサブタイトルを表示します。ヘルプページへのリンクを
// 含みます。
templ hintSubtitle() {
	@templ.Raw(templates.T(ctx, "topic_new_hint_html"))
}
