package search

import (
	"github.com/wikinoapp/wikino/go/internal/model"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// searchHelpURLはヘルプ「検索」のURL。ヘルプは日本語だけのため、表示言語によらず同じページへリンクする。
const searchHelpURL = "https://wikino.app/s/wikino/pages/62"

// queryErrorIDはキーワードの欄のエラーを収める要素のidです。
const queryErrorID = "q-error"

// ShowDataは検索の画面をレンダリングする元になるデータ。
type ShowData struct {
	// Queryは送られたキーワード。欄に入れ直す
	Query          string
	HasSpaceFilter bool
	FormErrors     *model.ValidationError

	// Searchedは検索したかを表す。検索していないときは、結果が無いことを伝えない
	Searched bool
	Pages    []viewmodel.SearchResultPage
}

func (d ShowData) hasQueryError() bool {
	return d.FormErrors != nil && d.FormErrors.HasFieldError("q")
}

// Showは検索の画面のコンテンツを表示します。
templ Show(data ShowData) {
	<div class="py-4">
		<div class="max-w-3xl w-full mx-auto">
			<div class="flex flex-col gap-4">
				<div class="px-4">
					@components.MainTitle(components.MainTitleData{
						Title:    templates.T(ctx, "search_show_heading"),
						Subtitle: description(),
					})
				</div>

				@components.ContentCard() {
					<form action={ templ.SafeURL(string(templates.SearchPath())) } method="GET" role="search" class="grid gap-2">
						<label class="sr-only" for="q">
							{ templates.T(ctx, "search_show_query_label") }
						</label>
						<div class="flex gap-2">
							<input
								autocomplete="off"
								autofocus
								class="input w-full border-muted-foreground focus-visible:ring-muted-foreground aria-invalid:border-destructive"
								id="q"
								name="q"
								placeholder={ templates.T(ctx, "search_show_query_placeholder") }
								type="search"
								value={ data.Query }
								data-search-query
								if data.HasSpaceFilter {
									data-search-query-has-space-filter
								}
								if data.hasQueryError() {
									aria-invalid="true"
									aria-describedby={ queryErrorID }
								}
							/>
							<button type="submit" class="btn rounded-full focus-visible:ring-muted-foreground">
								@templates.Icon("magnifying-glass-regular", "size-4")
								{ templates.T(ctx, "search_show_submit_button") }
							</button>
						</div>
						if data.hasQueryError() {
							<div id={ queryErrorID }>
								for _, message := range data.FormErrors.GetFieldErrors("q") {
									<p class="text-sm text-error">{ message }</p>
								}
							</div>
						}
					</form>
				}

				if data.Searched {
					<section class="px-4" aria-labelledby="search-results-heading">
						<h2 id="search-results-heading" class="sr-only">
							{ templates.T(ctx, "search_show_results_heading") }
						</h2>
						if len(data.Pages) == 0 {
							@components.EmptyState(components.EmptyStateData{
								Message:  templates.T(ctx, "search_show_no_results"),
								IconName: "magnifying-glass-regular",
							})
						} else {
							<div class="grid grid-cols-1 items-stretch gap-2 md:grid-cols-3">
								for _, result := range data.Pages {
									@components.CardLinkPage(result.Card, result.SpaceIdentifier)
								}
							</div>
						}
					</section>
				}
			</div>
		</div>
	</div>
}

// descriptionは、検索の画面の見出しの下に、何を検索できるかとヘルプへのリンクを示します。
templ description() {
	{ templates.T(ctx, "search_show_description") }
	<a href={ templ.SafeURL(searchHelpURL) } class="link-foreground" target="_blank">
		{ templates.T(ctx, "search_show_help_link") }
	</a>
}
