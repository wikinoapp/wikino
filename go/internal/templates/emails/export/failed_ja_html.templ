package export

// FailedJaHTMLは生成できなかったエクスポートの日本語HTMLテンプレート
templ FailedJaHTML(data Data) {
	エクスポートデータを作成できませんでした。<br/>
	<br/>
	スペースの内容は変わっていません。下のページからやり直せます。<br/>
	<br/>
	<a href={ templ.SafeURL(data.URL) }>エクスポート</a><br/>
	<br/>
	Wikino<br/>
	<a href={ templ.SafeURL(data.AppURL) }>{ data.AppURL }</a>
}
