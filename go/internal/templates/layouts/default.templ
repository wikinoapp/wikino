package layouts

import (
	"github.com/a-h/templ"
	"github.com/wikinoapp/wikino/go/internal/session"
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/templates/components"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// DefaultLayoutDataはデフォルトレイアウトに渡すデータ構造体です。GlobalNavは上部バーと
// 下部バーが共用するナビ状態 (ログイン状態・atname・現在ページ・スペース) を保持します。
// BreadcrumbHeaderはパンくずヘッダーを保持し、レイアウトが <main> の外で描画します。
type DefaultLayoutData struct {
	Meta       viewmodel.PageMeta
	HideFooter bool

	// HideNavigationは画面をグローバルナビの対象外にする。上部・下部バーと、固定の下部バーに
	// コンテンツが隠れないための余白を落とす。パンくずヘッダーはたどれるパンくず項目 (Pathがあり
	// IsCurrentでない項目) がある場合だけ残す。現在項目だけの経路はパンくずの中身として数えない。
	// スキップリンクは本フラグではなくヘッダーに追従する。飛ばす対象は本文の前に出るヘッダーであり、
	// ヘッダーが落ちるときだけ一緒に落ちる。未ログインのトップページが指定する。ナビ項目が同画面の
	// CTAと重複し、パンくず項目も持たないため、ヘッダーとスキップリンクはどちらも出ない。
	HideNavigation bool

	GlobalNav        components.GlobalNavData
	BreadcrumbHeader components.BreadcrumbHeaderData
}

// breadcrumbHeaderRenderDataはレイアウトのヘッダーとナビのデータをBreadcrumbHeaderが受け取る
// 値へまとめ、この画面がナビバーを出すかどうかを引き継ぐ。
func (d DefaultLayoutData) breadcrumbHeaderRenderData() components.BreadcrumbHeaderRenderData {
	return components.BreadcrumbHeaderRenderData{
		Header:        d.BreadcrumbHeader,
		GlobalNav:     d.GlobalNav,
		HideGlobalNav: d.HideNavigation,
	}
}

// Defaultはデフォルトのレイアウトです
templ Default(data DefaultLayoutData, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(data.Meta)
			@components.BreadcrumbListStructuredData(data.BreadcrumbHeader)
			<meta name="wikino-search-path" content={ string(templates.SearchPathFor(data.Meta.CurrentSpaceIdentifier)) }/>
		</head>

		<body class="bg-background">
			{{ headerData := data.breadcrumbHeaderRenderData() }}
			// キーボード / スクリーンリーダー利用者がヘッダーとその中のナビゲーションを飛ばして
			// メインコンテンツへ直接移動できるよう、最初のフォーカス可能要素としてスキップリンクを置く
			// (WCAG 2.4.1)。フォーカス時のみ左上に可視化する。条件はHideNavigationではなくヘッダーの
			// 描画要否に合わせる。バーを落としつつパンくずを残す画面には本文の前に飛ばすべきブロックが
			// 残り、ヘッダー自体が出ない画面はメインコンテンツから始まって飛ばす対象が無いためである。
			if headerData.ShouldRender() {
				<a
					href="#main"
					class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-tooltip focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-foreground focus:shadow focus:outline focus:outline-2 focus:outline-ring"
				>
					{ templates.T(ctx, "skip_to_main_content") }
				</a>
			}

			@components.Flash(session.FlashFromContext(ctx))

			// md未満で固定の下部ナビに最下部コンテンツ (編集画面のリンクカードなど) が隠れない
			// よう、下部余白を確保する。バーを出す画面ではバーが常時あり、md以上で自身を隠しつつ
			// bottom-2の位置にあるため、その高さ + 0.5remのオフセット分を確保する。PWAのスタンド
			// アロン表示でナビをホームインジケータの上へ押し上げたときも余白が不足しないよう
			// env(safe-area-inset-bottom) を加算する。safe-areaの無い環境では0になるためデスク
			// トップ・非スタンドアロン表示は従来どおり。md以上ではナビが隠れるため、バーが描画され
			// なくなる幅と揃えて余白を外す。バーを出さない画面では隠れる相手が無いため、余白ごと外す。
			<div
				class={ "flex-1 flex flex-col min-h-screen",
					templ.KV("pb-[calc(var(--app-bottom-nav-max-height)+0.5rem+env(safe-area-inset-bottom))] md:pb-0", !data.HideNavigation) }
			>
				// #mainへのスキップリンクが共有パンくずヘッダーを飛ばせるよう、<main> の外で描画する。
				// ヘッダーはPC向けのナビバーを持つため、バーか、たどれるパンくず項目 (Pathがあり
				// IsCurrentでない項目) のどちらかを持つ画面で描画する。現在項目だけの経路はパンくずの
				// 中身として数えない。その判断と上余白はヘッダー自身が持つため、レイアウトは本文の上に
				// 空白だけとなって残り得るラッパーで包まない。
				@components.BreadcrumbHeader(headerData)

				<main id="main" tabindex="-1">
					@content
				</main>

				if !data.HideFooter {
					@components.Footer()
				}
			</div>

			// pb-safe (padding-bottom: env(safe-area-inset-bottom)) を付け、PWAのスタンドアロン
			// 表示でナビのピルをホームインジケータの上へ押し上げる。このラッパーはbottom-2基点の縦
			// フレックスのため、下パディングを足すとピルがsafe-area分だけ上がる。safe-areaの無い
			// 環境ではenvが0になるため位置は従来どおり。下部バーはmd以上では自身を隠し、上部バーに
			// 役割を譲る。
			if !data.HideNavigation {
				<div class="fixed bottom-2 left-1/2 z-sticky-bar flex w-full -translate-x-1/2 flex-col items-center px-2 pb-safe">
					@components.GlobalNavBottomBar(data.GlobalNav)
				</div>
			}
		</body>
	</html>
}
