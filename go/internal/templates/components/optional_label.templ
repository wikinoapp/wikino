package components

import "github.com/wikinoapp/wikino/go/internal/templates"

// OptionalLabelDataは任意項目であることを示すラベルのデータです。
type OptionalLabelData struct {
	For   string
	Label string
}

// OptionalLabelは任意項目であることを示すラベルを表示します。Forにはこのラベルが説明する
// コントロールのidを必ず渡してください。空にすると関連先を持たないラベルになります。
templ OptionalLabel(data OptionalLabelData) {
	<label class="label" for={ data.For }>
		<span class="flex items-center gap-1">
			{ data.Label }
			<span class="text-xs text-muted-foreground">
				- { templates.T(ctx, "form_optional") }
			</span>
		</span>
	</label>
}
