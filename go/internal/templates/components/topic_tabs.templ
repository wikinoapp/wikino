package components

import "github.com/wikinoapp/wikino/go/internal/templates"

// TopicTabsData はトピックのページ/編集提案タブに渡すデータ構造体です
type TopicTabsData struct {
	PagesPath       string
	SuggestionsPath string
	ActiveTab       TopicTab
}

// TopicTab はアクティブなタブを表す型です
type TopicTab string

const (
	TopicTabPages       TopicTab = "pages"
	TopicTabSuggestions TopicTab = "suggestions"
)

// TopicTabs はトピック詳細画面と編集提案一覧を行き来するためのタブを表示します
templ TopicTabs(data TopicTabsData) {
	<div class="flex gap-4 border-b">
		if data.ActiveTab == TopicTabPages {
			<a
				href={ templ.SafeURL(data.PagesPath) }
				class="flex items-center gap-2 px-2 py-2 text-sm border-b-2 border-brand-green-500"
			>
				@templates.Icon("file-fill", "size-4")
				{ templates.T(ctx, "topic_show_tab_pages") }
			</a>
			<a
				href={ templ.SafeURL(data.SuggestionsPath) }
				class="flex items-center gap-2 px-2 py-2 text-sm text-muted-foreground hover:text-foreground"
			>
				@templates.Icon("git-pull-request-regular", "size-4")
				{ templates.T(ctx, "topic_show_tab_suggestions") }
			</a>
		} else {
			<a
				href={ templ.SafeURL(data.PagesPath) }
				class="flex items-center gap-2 px-2 py-2 text-sm text-muted-foreground hover:text-foreground"
			>
				@templates.Icon("file-regular", "size-4")
				{ templates.T(ctx, "topic_show_tab_pages") }
			</a>
			<a
				href={ templ.SafeURL(data.SuggestionsPath) }
				class="flex items-center gap-2 px-2 py-2 text-sm border-b-2 border-brand-green-500"
			>
				@templates.Icon("git-pull-request-fill", "size-4")
				{ templates.T(ctx, "topic_show_tab_suggestions") }
			</a>
		}
	</div>
}
