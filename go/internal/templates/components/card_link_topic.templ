package components

import (
	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// CardLinkTopic renders a reusable topic link card shared by the home page's "joined topics"
// section and the space page's topic section. The card links to the topic detail and, when
// topic.CanCreatePage is true, surfaces a "new page" icon link (shown on hover for non-touch
// devices and always shown on touch devices), mirroring CardLinkPage's CanEdit pattern.
//
// [Ja] CardLinkTopic はホーム画面の「参加中のトピック」セクションとスペース画面のトピック
// セクションで共有する、再利用可能なトピックリンクカードを表示する。カードはトピック詳細へ
// リンクし、topic.CanCreatePage が true のときは「新規ページ」アイコンリンク (非タッチ
// デバイスではホバー時、タッチデバイスでは常時表示) を出す。CardLinkPage の CanEdit
// パターンを踏襲している。
templ CardLinkTopic(topic viewmodel.CardLinkTopic) {
	<div class="group card relative min-h-[74px] transition p-0 duration-200 ease-in-out hover:border-brand-600">
		if topic.CanCreatePage {
			<div class="touch:hidden non-touch:flex absolute right-2 top-2 z-10">
				<a
					href={ templ.SafeURL(string(templates.NewPagePath(topic.SpaceIdentifier, topic.Number))) }
					class="
						rounded-full p-2 leading-none text-center transition duration-150 ease-in-out shadow-sm
						opacity-0 group-hover:opacity-100
						group-hover:bg-primary hover:bg-primary/90
						group-hover:backdrop-blur-md hover:backdrop-blur-md
					"
					title={ templates.T(ctx, "card_link_topic_new_page") }
				>
					@templates.Icon("plus-regular", "size-4 fill-primary-foreground")
				</a>
			</div>
		}

		<div class="card-body h-full">
			<div class="flex h-full">
				<a
					class="flex-1 min-w-0 h-full px-3 py-2"
					href={ templ.SafeURL(string(templates.TopicPath(topic.SpaceIdentifier, topic.Number))) }
				>
					<div class="flex gap-2 h-full">
						<div class="flex items-center h-full">
							@templates.Icon(topic.TopicIconName, "flex-none size-6 fill-muted-foreground")
						</div>

						<div class="flex flex-col gap-0.5 min-w-0">
							if topic.SpaceName != "" {
								<span class="line-clamp-1 text-xs text-muted-foreground min-w-0">
									{ topic.SpaceName }
								</span>
							}

							<span class="line-clamp-2 text-sm font-bold">
								{ topic.Name }
							</span>
						</div>
					</div>
				</a>

				if topic.CanCreatePage {
					<div class="touch:flex non-touch:hidden h-fit self-center pr-3">
						<a
							href={ templ.SafeURL(string(templates.NewPagePath(topic.SpaceIdentifier, topic.Number))) }
							class="btn-sm-icon-primary rounded-full"
							title={ templates.T(ctx, "card_link_topic_new_page") }
						>
							@templates.Icon("plus-regular", "size-4")
						</a>
					</div>
				}
			</div>
		</div>
	</div>
}
