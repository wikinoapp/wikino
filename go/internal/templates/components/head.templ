package components

import (
	"strconv"

	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// HeadはHTMLのheadセクションの共通メタタグを出力します
templ Head(meta viewmodel.PageMeta) {
	<meta charset="UTF-8"/>

	<title>{ meta.Title }</title>

	<meta name="description" content={ meta.Description }/>

	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>

	// ダークモードのフラグが有効な閲覧者にだけ、両方の配色に対応することを宣言する。ブラウザはスタイルシートより前に
	// 読んだ宣言でフォーム部品・スクロールバーの配色を決め、theme-colorでアドレスバーをそれぞれの背景の色に揃える
	if meta.DarkModeEnabled {
		<meta name="color-scheme" content="light dark"/>
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf5f1"/>
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121a1b"/>
	}

	// iOSのSafariで「ホームに追加」した時にフルスクリーン表示にする
	<meta name="apple-mobile-web-app-capable" content="yes"/>

	<meta property="og:description" content={ meta.Description }/>
	<meta property="og:image" content={ meta.OGImage }/>
	// 寸法が決まっている画像だけが宣言する。SNSは寸法が分かると画像を取得する前にプレビューの枠を組める
	if meta.OGImageWidth > 0 && meta.OGImageHeight > 0 {
		<meta property="og:image:width" content={ strconv.Itoa(meta.OGImageWidth) }/>
		<meta property="og:image:height" content={ strconv.Itoa(meta.OGImageHeight) }/>
	}
	<meta property="og:locale" content={ meta.OGLocale }/>
	<meta property="og:site_name" content="Wikino"/>
	<meta property="og:title" content={ meta.Title }/>
	<meta property="og:type" content={ meta.OGType }/>
	// 正規アドレスが分かっている画面だけがそれを宣言する。空の値は「canonicalが無い」ことには
	// ならず、空のhrefも空のcontentもリクエストされたURLに解決されるため、画面のクエリ違いが
	// それぞれ自分自身を正規アドレスとして宣言してしまう。
	if meta.OGURL != "" {
		<meta property="og:url" content={ meta.OGURL }/>
	}

	<meta name="twitter:card" content={ meta.TwitterCard }/>
	<meta name="twitter:site" content="@wikino_app"/>
	<meta name="twitter:title" content={ meta.Title }/>
	<meta name="twitter:description" content={ meta.Description }/>
	<meta name="twitter:image" content={ meta.OGImage }/>

	<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png"/>
	if meta.OGURL != "" {
		<link rel="canonical" href={ meta.OGURL }/>
	}
	// フィードは公開範囲に応じて画面ごとに選ぶ。どの画面でも、告知するのは誰が取得しても同じ内容を返すフィードだけである
	for _, feed := range meta.Feeds {
		<link rel="alternate" type="application/atom+xml" title={ feed.Title } href={ feed.URL }/>
	}
	<link rel="icon" href="/static/images/favicon.ico" sizes="any"/>
	<link rel="icon" href="/static/images/icon.svg" type="image/svg+xml"/>
	<link rel="manifest" href="/manifest.json"/>
	// ヒントはページ側が宣言する。接続するオリジンを、そこへ実際にリクエストするページに限るため
	for _, origin := range meta.PreconnectOrigins {
		<link rel="preconnect" href={ origin }/>
	}

	<link rel="stylesheet" href={ "/static/css/style.css?v=" + meta.AssetVersion }/>

	// bodyの解析前に <head> でインラインに実行し、ライトで一度描画してから切り替わることが無いようにする
	if meta.DarkModeEnabled {
		<script>
			(() => {
				try {
					if (matchMedia("(prefers-color-scheme: dark)").matches) {
						document.documentElement.classList.add("dark");
					}
				} catch (_) {}
			})();
		</script>
	}
	<script type="module" src={ "/static/js/main.js?v=" + meta.AssetVersion }></script>
	// 機能のエントリは、その機能を使う画面だけが宣言する。モジュールのスクリプトは書いた順に実行されるため、
	// main.jsの初期化のあとに動く
	if path := meta.FeatureScript.Path(); path != "" {
		<script type="module" src={ path + "?v=" + meta.AssetVersion }></script>
	}
}
