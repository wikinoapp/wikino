package components

import "github.com/wikinoapp/wikino/go/internal/viewmodel"

// Head はHTMLのheadセクションの共通メタタグを出力します
templ Head(meta viewmodel.PageMeta) {
	<meta charset="UTF-8"/>

	<title>{ meta.Title }</title>

	<meta name="description" content={ meta.Description }/>

	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>

	// iOSのSafariで「ホームに追加」した時にフルスクリーン表示にする
	<meta name="apple-mobile-web-app-capable" content="yes"/>

	<meta property="og:description" content={ meta.Description }/>
	<meta property="og:image" content={ meta.OGImage }/>
	<meta property="og:locale" content={ meta.OGLocale }/>
	<meta property="og:site_name" content="Wikino"/>
	<meta property="og:title" content={ meta.Title }/>
	<meta property="og:type" content={ meta.OGType }/>
	// Only a screen that knows its canonical address declares one. An empty value would not mean
	// "no canonical": both an empty href and an empty content resolve to the requested URL, so every
	// query variant of a screen would declare itself as its own canonical address.
	//
	// [Ja] 正規アドレスが分かっている画面だけがそれを宣言する。空の値は「canonical が無い」ことには
	// ならず、空の href も空の content もリクエストされた URL に解決されるため、画面のクエリ違いが
	// それぞれ自分自身を正規アドレスとして宣言してしまう。
	if meta.OGURL != "" {
		<meta property="og:url" content={ meta.OGURL }/>
	}

	<meta name="twitter:card" content="summary"/>
	<meta name="twitter:site" content="@wikino_app"/>
	<meta name="twitter:title" content={ meta.Title }/>
	<meta name="twitter:description" content={ meta.Description }/>
	<meta name="twitter:image" content={ meta.OGImage }/>

	<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png"/>
	if meta.OGURL != "" {
		<link rel="canonical" href={ meta.OGURL }/>
	}
	<link rel="icon" href="/static/images/favicon.ico" sizes="any"/>
	<link rel="icon" href="/static/images/icon.svg" type="image/svg+xml"/>
	<link rel="manifest" href="/manifest.json"/>
	<link rel="preconnect" href="https://challenges.cloudflare.com"/> // Cloudflare Turnstile

	<link rel="stylesheet" href={ "/static/css/style.css?v=" + meta.AssetVersion }/>

	<script defer src="/static/js/vendor/htmx-4.0.0-alpha8.min.js"></script>
	// TODO: ダークモード対応時に以下のスクリプトを有効化する
	// <script>
	//     (() => {
	//         try {
	//             if (matchMedia("(prefers-color-scheme: dark)").matches) {
	//                 document.documentElement.classList.add("dark");
	//             }
	//         } catch (_) {}
	//     })();
	// </script>
	<script type="module" src={ "/static/js/main.js?v=" + meta.AssetVersion }></script>
}
