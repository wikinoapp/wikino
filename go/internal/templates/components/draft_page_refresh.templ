package components

import (
	"strconv"

	"github.com/wikinoapp/wikino/go/internal/templates"
	"github.com/wikinoapp/wikino/go/internal/viewmodel"
)

// DraftPageRefreshTrigger listens for draft-autosaved and refreshes both related-page listings.
// It lives outside the list swap targets so their OOB updates do not remove the listener, and it
// reads the screen's related-page state from relatedPageState at request time instead of embedding
// it in its own URL, so a listing advanced after the initial render is still reflected. The shared
// hx-sync group drops an automatic refresh while a manual load-more request is running;
// load-more links use replace, so a manual action also supersedes an older automatic refresh. This
// prevents stale responses while preserving the reader’s explicit action.
//
// [Ja] DraftPageRefreshTrigger は draft-autosaved を受け取り、関連ページ一覧 2 つを再取得する。
// 一覧の OOB スワップでリスナーが消えないよう一覧のスワップ対象の外に置く。画面の関連ページ状態は
// 自身の URL へ埋め込まず、リクエスト時に relatedPageState から読むため、初回描画のあとに進めた一覧も
// 反映される。共有 hx-sync グループは手動の「もっと見る」実行中なら自動再取得を破棄し、「もっと見る」
// 側は先行する自動再取得を置き換える。これにより古い応答を防ぎながら、利用者の明示操作を優先する。
templ DraftPageRefreshTrigger(spaceIdentifier viewmodel.SpaceIdentifier, pageNumber int32, state viewmodel.PageLinkState) {
	if viewmodel.NormalizePageLinkContext(string(state.Context)).IsEdit() {
		<div
			id={ draftPageRefreshTriggerID }
			hidden
			hx-get={ string(templates.PageDraftPagePath(spaceIdentifier, pageNumber)) }
			hx-trigger="draft-autosaved from:window"
			hx-swap="none"
			hx-include={ relatedPageStateSelector }
			hx-sync={ draftRelatedPageRequestSync }
		></div>
		@relatedPageState(state)
	}
}

// relatedPageState holds the pagination mode and state of the editor's three related-page listings.
// Every "load more" link and the draft refresh include it, so each request carries the state of the
// listings it does not advance.
//
// Each listing owns one element inside the container and a fragment response replaces only its own
// (see linkPageStateOOB and friends). Replacing the container as a whole would make two requests
// that overlap in flight undo each other: the one that returns last would write back the values it
// read before the other advanced them. The context is immutable for one full-page editor visit and
// therefore needs no OOB replacement.
//
// [Ja] relatedPageState は編集画面のページング方式と 3 つの関連ページ一覧の状態を保持する。各
// 「もっと見る」リンクと下書き再取得がこれを含めるため、どのリクエストも自分が進めない一覧の状態を運ぶ。
//
// コンテナの中では 1 つの一覧が 1 つの要素を持ち、フラグメント応答は自分の分だけを差し替える
// (linkPageStateOOB などを参照)。コンテナごと差し替えると、実行が重なった 2 つのリクエストが互いの
// 更新を打ち消してしまう。後に返ったほうが、もう片方が進める前に読んだ値を書き戻すためである。
// 文脈は 1 回の編集画面表示中には変わらないため、OOB で差し替える必要はない。
templ relatedPageState(state viewmodel.PageLinkState) {
	<div id={ relatedPageStateID } hidden>
		<input
			id={ relatedPageContextStateID }
			type="hidden"
			name={ viewmodel.PageLinkContextQueryParam }
			value={ string(viewmodel.NormalizePageLinkContext(string(state.Context))) }
		/>
		@linkPageState(state, false)
		@nestedBacklinkPageState(state, false)
		@pageBacklinkPageState(state, false)
	</div>
}

// relatedPageStateOOB reconciles every editor listing state after a draft refresh. Unlike a
// single-listing response, the refresh has fetched all three totals and can safely move stale page
// numbers back into the ranges that still exist after the draft changes.
//
// [Ja] relatedPageStateOOB は、下書き再取得後に編集画面の全一覧状態を整合させる。単一一覧の応答と違い、
// 再取得は 3 一覧すべての総件数を取得済みなので、下書き変更後も存在する範囲へ古いページ番号を安全に戻せる。
templ relatedPageStateOOB(state viewmodel.PageLinkState) {
	if viewmodel.NormalizePageLinkContext(string(state.Context)).IsEdit() {
		@linkPageState(state, true)
		@nestedBacklinkPageState(state, true)
		@pageBacklinkPageState(state, true)
	}
}

// linkPageStateOOB advances the link list's share of the shared state, and renders nothing on the
// public page, which has no state element. The two other listings are left untouched so that a
// response cannot roll back what they advanced while this request was in flight.
//
// [Ja] linkPageStateOOB は共有状態のうちリンク一覧の分を進める。状態要素を持たない公開ページでは
// 何も描画しない。他の 2 つの一覧には触れないため、本リクエストの実行中にそれらが進めた分を応答が
// 巻き戻すことはない。
templ linkPageStateOOB(state viewmodel.PageLinkState) {
	if viewmodel.NormalizePageLinkContext(string(state.Context)).IsEdit() {
		@linkPageState(state, true)
	}
}

// nestedBacklinkPageStateOOB advances the selected card and its nested backlink page together, as
// one element: the page number alone means nothing without the card it belongs to.
//
// [Ja] nestedBacklinkPageStateOOB は、選択したカードとそのネストしたバックリンクのページを 1 つの
// 要素としてまとめて進める。ページ番号だけでは、どのカードのものか分からないためである。
templ nestedBacklinkPageStateOOB(state viewmodel.PageLinkState) {
	if viewmodel.NormalizePageLinkContext(string(state.Context)).IsEdit() {
		@nestedBacklinkPageState(state, true)
	}
}

// pageBacklinkPageStateOOB advances the page-level backlink list's share of the shared state.
//
// [Ja] pageBacklinkPageStateOOB は共有状態のうちページ自身のバックリンク一覧の分を進める。
templ pageBacklinkPageStateOOB(state viewmodel.PageLinkState) {
	if viewmodel.NormalizePageLinkContext(string(state.Context)).IsEdit() {
		@pageBacklinkPageState(state, true)
	}
}

// linkPageState carries the page of the link list. The element is rendered even while the listing
// sits on its first page, because an out-of-band swap can only replace an id that already exists.
// A listing on its first page sends an empty value, which the handlers read as page one.
//
// [Ja] linkPageState はリンク一覧のページを運ぶ。一覧が 1 ページ目にあるときも要素は描画する。OOB
// スワップは既に存在する id しか差し替えられないためである。1 ページ目の一覧は空の値を送り、Handler は
// これを 1 ページ目として読む。
templ linkPageState(state viewmodel.PageLinkState, oob bool) {
	<input
		id={ linkPageStateID }
		type="hidden"
		name={ viewmodel.LinkPageQueryParam }
		value={ relatedPageStateValue(state.LinkPage) }
		if oob {
			hx-swap-oob="outerHTML"
		}
	/>
}

// nestedBacklinkPageState carries which card's nested backlink list is advanced and how far, plus
// the link-list page holding that card. The parent page belongs here rather than beside the link
// list's own page: it describes where the selected card lives, which is what a full-page URL built
// from this state has to render for the card to exist at all.
//
// [Ja] nestedBacklinkPageState は、どのカードのネストしたバックリンク一覧をどこまで進めたかと、その
// カードを含むリンク一覧のページを運ぶ。親ページはリンク一覧自身のページの側ではなくここに置く。
// 選択カードがどこに存在するかを表す値であり、この状態から組み立てるフルページ URL がカードを成立
// させるために描画しなければならないページだからである。
templ nestedBacklinkPageState(state viewmodel.PageLinkState, oob bool) {
	<span
		id={ nestedBacklinkStateID }
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		<input
			type="hidden"
			name={ viewmodel.LinkedPageNumberQueryParam }
			value={ nestedBacklinkStateValue(state, state.LinkedPageNumber) }
		/>
		<input
			type="hidden"
			name={ viewmodel.LinkedBacklinkPageQueryParam }
			value={ nestedBacklinkStateValue(state, state.LinkedBacklinkPage) }
		/>
		<input
			type="hidden"
			name={ viewmodel.LinkedPageParentPageQueryParam }
			value={ nestedBacklinkStateValue(state, state.NestedBacklinkLinkPage()) }
		/>
	</span>
}

// pageBacklinkPageState carries the page of the page's own backlink list.
//
// [Ja] pageBacklinkPageState はページ自身のバックリンク一覧のページを運ぶ。
templ pageBacklinkPageState(state viewmodel.PageLinkState, oob bool) {
	<input
		id={ pageBacklinkStateID }
		type="hidden"
		name={ viewmodel.PageBacklinkPageQueryParam }
		value={ relatedPageStateValue(state.PageBacklinkPage) }
		if oob {
			hx-swap-oob="outerHTML"
		}
	/>
}

// relatedPageStateValue renders a listing's page, leaving the first page empty so the common
// requests stay short.
//
// [Ja] relatedPageStateValue は一覧のページを描画する。1 ページ目は空にして、通常のリクエストを
// 短いままに保つ。
func relatedPageStateValue(page int32) string {
	if page <= 1 {
		return ""
	}

	return strconv.Itoa(int(page))
}

// nestedBacklinkStateValue renders one part of the nested backlink state, and empties every part
// unless a card is selected and its listing is past its first page. A card number without a page
// past the first would select a card the screen is not actually holding open.
//
// [Ja] nestedBacklinkStateValue はネストしたバックリンク状態の 1 つを描画する。カードが選ばれていて、
// かつその一覧が 2 ページ目以降にある場合を除き、すべて空にする。1 ページ目のままのカード番号は、
// 画面が実際には開いていないカードを選んでしまうためである。
func nestedBacklinkStateValue(state viewmodel.PageLinkState, value int32) string {
	if !state.HasNestedBacklinkState() {
		return ""
	}

	return strconv.Itoa(int(value))
}
