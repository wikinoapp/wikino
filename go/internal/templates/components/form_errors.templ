package components

import "github.com/wikinoapp/wikino/go/internal/model"

// FormErrorsはフォームのグローバルエラーを表示します。
templ FormErrors(formErrors *model.ValidationError) {
	if formErrors != nil && len(formErrors.Global) > 0 {
		for _, errorMsg := range formErrors.Global {
			<div class="alert" data-variant="destructive">
				<section>{ errorMsg }</section>
			</div>
		}
	}
}

// FormErrorSummaryはグローバルフォームエラーを余白付きの領域に表示します。
templ FormErrorSummary(formErrors *model.ValidationError) {
	if formErrors != nil && len(formErrors.Global) > 0 {
		<div class="px-4">
			@FormErrors(formErrors)
		</div>
	}
}
