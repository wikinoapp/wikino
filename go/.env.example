# Wikino Go版 環境変数設定ファイル（サンプル）
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# cp .env.example .env

DATABASE_URL=
WIKINO_ADMIN_IP=
WIKINO_COOKIE_DOMAIN=
WIKINO_DISABLE_RATE_LIMIT=
WIKINO_DOMAIN=
WIKINO_IMGPROXY_KEY=
WIKINO_IMGPROXY_SALT=
WIKINO_IMGPROXY_URL=
WIKINO_MAINTENANCE_MODE=
WIKINO_PORT=
WIKINO_R2_BUCKET_NAME=
WIKINO_RAILS_APP_URL=
WIKINO_SENTRY_DEBUG=                    # Sentry SDK のデバッグログ出力。"true" で有効 (既定: false)
WIKINO_SENTRY_DSN=                      # Sentry のプロジェクト DSN。空のときは Sentry を無効化する (既定: 空)
WIKINO_SENTRY_ENVIRONMENT=              # Sentry の environment タグ。空の場合は APP_ENV を使用 (既定: APP_ENV)
WIKINO_SENTRY_TRACES_SAMPLE_RATE=       # パフォーマンストレースのサンプリングレート (0.0〜1.0、既定: 0.5)
WIKINO_SESSION_HTTPONLY=
WIKINO_SESSION_SECURE=
WIKINO_TURNSTILE_ENABLED=
WIKINO_TURNSTILE_SECRET_KEY=
WIKINO_TURNSTILE_SITE_KEY=
