      "name": "cursor",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "0",
      "description": "Number of items per page (n. Defaults to 20; values over 100 are treated as 100)",
      "name": "limit",
      "shorthand": "",
      "type": "int32"
    }
  ],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Lists the drafts the token's owner has in the space, most recently modified first.\nDrafts of new pages that have not been published yet are included.\nDrafts of pages in the trash are not included.\n\nThe list does not include bodies; it includes an excerpt of the beginning of each body (`excerpt`) instead.\nTo read a body, use `wikino draft get`.\nWhen you need bodies in the list, include `body` in `--fields`.\n\nBy default, only one page of the API's default size (20 items) is fetched.\nWhen there is a next page, how to fetch it is printed to standard error.\nWith `--all`, all items are fetched and the output format changes to JSON Lines (see \"Output\").\n\nDrafts of pages in private topics are included only when the token has the topic:read scope and the member can see the topic.",
  "output": "  Prints `{\"items\": [...], \"next_cursor\": ...}` with the following fields for each draft.\n    page_number   The number of the draft's page. Pass it to `wikino draft get` and others\n    title         The draft's title. null for drafts without a title\n    topic_number  The number of the topic the draft's page belongs to\n    topic_name    The name of the topic the draft's page belongs to\n    modified_at   When the draft's content was last modified (RFC 3339). Autosaves in the web UI also update it\n    url           The URL of the edit screen of the draft's page in the web UI\n    excerpt       An excerpt of the beginning of the body: the first 80 characters with newlines collapsed to spaces,\n                  ending with \"…\" when truncated. Not in the API response; the CLI makes it from the body\n    body          The body (Markdown). Not printed by default; printed only when included in `--fields`\n  `next_cursor` is the cursor of the next page, or null when there is no more.\n  With `--all`, prints JSON Lines with one item per line, without `next_cursor`.\n  When there are no drafts, returns an empty list with exit code 0.",
  "short": "List drafts",
  "subcommands": [],
  "usage": "wikino draft list [flags]"
}

=== wikino draft publish --help --json
{
  "args": [
    {
      "name": "page_number",
      "required": true,
      "variadic": false
    }
  ],
  "command": "wikino draft publish",
  "errors": "  2  The page number is not a positive integer, neither or both of `--if-match` and `--force` are given, `--if-match` is empty or `*`, `--fields` has an unknown field, or `--dry-run` is combined with `--fields`\n  3  Not logged in, or the token is invalid or expired (401)\n  4  The token lacks the draft_page:write or page:write scope, or the member is not allowed to save drafts and publish pages (403)\n  5  You have no draft of the page, the page does not exist or is in the trash, or the page is in a private topic you cannot see (404).\n     If you get 5 when publishing again, the draft has already been published or deleted. Check the page with `wikino page get`\n  6  The draft has been updated since you read it (412). Check the current content with `wikino draft get`, and publish again with the new version if it is fine to publish\n  7  The draft has no title, the title has characters that cannot be used, or a page with the same title exists in the topic (422).\n     Fix the title of the draft with `wikino draft update --title` and publish again\n  9  Confirmation by the user is required because `--yes` is not given, or the confirmation was declined in a terminal",
  "examples": "  # Read the draft of page 12 and check its version, then ask for confirmation to publish it\n  wikino draft get 12 --md\n  wikino draft publish 12 --if-match '\"d41d8cd9\"'\n\n  # Publish without asking, after getting the user's approval\n  wikino draft publish 12 --if-match '\"d41d8cd9\"' --yes\n\n  # Check the request and the targets of the wikilinks in the body (without sending)\n  wikino draft publish 12 --if-match '\"d41d8cd9\"' --dry-run",
  "flags": [
    {
      "default": "false",
      "description": "Print the requests that would be sent without sending them",
      "name": "dry-run",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "false",
      "description": "Overwrite the latest version, fetched just before, without checking the version you read",
      "name": "force",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Write only if the version is still the one you read (etag from the output of `get`)",
      "name": "if-match",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Run without asking for the user's confirmation",
      "name": "yes",
      "shorthand": "",
      "type": "bool"
    }
  ],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Publishes the page with the given page number using the title and body of your draft, and prints the published page.\nPublishing deletes the draft together with its revisions, and adds one revision to the page's history.\nA page that has not been published yet becomes published.\nThe current content of the page is not checked, so the draft overwrites the page even if the page was updated after the draft was created.\n\nPass the version of the draft you read in `--if-match`.\nThe version is `etag` in the output of `wikino draft get`.\nIf the draft has been updated since you read it (including automatic saves in the web editor), the command fails with exit code 6 without publishing.\nWith `--force`, the command does not check the version and publishes the latest draft it has just fetched.\n\nBefore publishing, the command fetches the draft and checks the targets of the wikilinks in its body.\nIf a wikilink in the body points to a page that does not exist, the target is created as an unpublished page.\nIf any targets will be created, the command lists them on standard error after publishing.\nThe list is an estimate made just before publishing, and can differ from the actual result if other users create or delete pages in between.\n\nBecause this publishes a page, the command asks for confirmation before publishing unless `--yes` is given.\nThe confirmation shows the change of the title and the numbers of added and deleted lines of the body compared with the current page, the link targets that will be created, and that the draft will be deleted after publishing.\nWhen run from a terminal, it shows these and asks.\nOtherwise (when run from an agent or a script), it does not send the publish request; it prints what will happen (`changes`) and the command to run after approval (`confirm_command`) as JSON on standard output, and exits with code 9.\nShow `changes` to the user, and run `confirm_command` as is after getting approval.\n`confirm_command` contains the version fetched for the confirmation in `--if-match`.\nA draft without a title cannot be published, so the command fails with exit code 7 without asking for confirmation.\n\nPublishing requires the draft_page:write and page:write scopes on the token.\nPublishing drafts of pages in private topics also requires the topic:read scope.",
  "output": "  Prints the published page with the same fields as `wikino page get` (including `etag`).\n  `etag` is the version of the page after publishing; pass it to `--if-match` to update the page next.\n  The human-readable output omits the body and prints a completion line to standard error.\n  If link targets were likely created by wikilinks in the body, they are listed on standard error, even with JSON output.\n  Without `--yes` and outside a terminal, prints `{\"status\": \"confirmation_required\", \"changes\": [...], \"confirm_command\": \"...\"}` without publishing, and exits with code 9.\n  With `--dry-run`, prints the request and the targets of the wikilinks in the body as `{\"dry_run\": true, \"requests\": [...], \"wikilinks\": [...]}` without sending the publish request. It does not ask for confirmation.\n  See the help of `wikino page update` for the fields of `wikilinks`.\n  Fetching the draft and checking the link targets (reads) are sent even with `--dry-run`.\n  `--dry-run` cannot be combined with `--fields`.",
  "short": "Publish a draft",
  "subcommands": [],
  "usage": "wikino draft publish <page_number> [flags]"
}

=== wikino draft revision --help --json
{
  "args": [],
  "command": "wikino draft revision",
  "errors": "  A missing or unknown subcommand fails as a usage error (exit code 2).",
  "examples": "  # List the revisions of the draft of page 12\n  wikino draft revision list 12\n\n  # Read the body of a revision as Markdown in the Wikino file format\n  wikino draft revision get 12 0b9d3a52-6f0e-4c1a-9d7e-2f4b8c1e5a30 --md",
  "flags": [],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Works with the revisions of drafts owned by the token's owner.\n\nA revision is a record of the title and body of a draft at a point in time, and does not change after it is created.\nRevisions are created when a draft is created or updated, and when it is saved manually or restored in the web editor.\nAutomatic saves in the web editor do not create revisions, so the latest revision is not always the same as the current draft.\nPublishing or deleting a draft also deletes its revisions.",
  "output": "  See the help of each subcommand.",
  "short": "Work with draft revisions",
  "subcommands": [
    {
      "command": "wikino draft revision get",
      "name": "get",
      "short": "Print a revision of a draft"
    },
    {
      "command": "wikino draft revision list",
      "name": "list",
      "short": "List the revisions of a draft"
    }
  ],
  "usage": "wikino draft revision <command>"
}

=== wikino draft revision get --help --json
{
  "args": [
    {
      "name": "page_number",
      "required": true,
      "variadic": false
    },
    {
      "name": "revision_id",
      "required": true,
      "variadic": false
    }
  ],
  "command": "wikino draft revision get",
  "errors": "  2  The page number is not a positive integer, the revision ID is not a UUID, `--md` is combined with `--json`, `--fields`, or `--jq`, or `--fields` has an unknown field\n  3  Not logged in, or the token is invalid or expired (401)\n  4  The token lacks the draft_page:read scope (403)\n  5  The revision does not exist, is not a revision of the draft of the page, or the draft was published or deleted and has no revisions (404).\n     Check the revision IDs with `wikino draft revision list`",
  "examples": "  # Print a revision of the draft of page 12\n  wikino draft revision get 12 0b9d3a52-6f0e-4c1a-9d7e-2f4b8c1e5a30\n\n  # Write the body of the revision to a file as Markdown in the Wikino file format\n  wikino draft revision get 12 0b9d3a52-6f0e-4c1a-9d7e-2f4b8c1e5a30 --md > revision.md\n\n  # Print only the creation time of the revision\n  wikino draft revision get 12 0b9d3a52-6f0e-4c1a-9d7e-2f4b8c1e5a30 --jq .created_at",
  "flags": [
    {
      "default": "false",
      "description": "Print a page file in the Wikino file format (Markdown with frontmatter)",
      "name": "md",
      "shorthand": "",
      "type": "bool"
    }
  ],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Prints the revision of your draft with the given page number and revision ID, including its body.\nThe revision ID is `id` in the output of `wikino draft revision list`.\n\nWith `--md`, prints a page file in the Wikino file format (Markdown with frontmatter).\nTo read the body, `--md` is better because line breaks and quotes are not escaped.\n\nRevisions do not change after they are created, so they have no version (`etag`).\nTo bring the draft back to the content of a past revision, pass its body to `wikino draft update`.\nThe `--md` output has no `wikino_etag`, so it cannot be written back with `--md-file` as is.\n\nReading revisions of drafts of pages in private topics requires the topic:read scope in addition to draft_page:read on the token.",
  "output": "  Prints the revision with the fields of `wikino draft revision list` (without excerpt, with body).\n  With `--md`, prints a page file in the Wikino file format instead of JSON.\n  The frontmatter has only `wikino_title`, followed by the body as is. For revisions without a title, no frontmatter is written.\n  When the body itself starts with frontmatter, the key is added to that block.",
  "short": "Print a revision of a draft",
  "subcommands": [],
  "usage": "wikino draft revision get <page_number> <revision_id> [flags]"
}

