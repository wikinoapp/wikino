    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Lists the topics of the space in ascending order of topic number.\n\nBy default, fetches only one page with the API's default size (20).\nWhen there is a next page, prints how to fetch it to standard error.\nWith `--all`, fetches every item and the output becomes JSON Lines (see Output).\n\nPrivate topics are included only when the token has the topic:read scope and the member can see the topic.",
  "output": "  Prints `{\"items\": [...], \"next_cursor\": ...}` with these fields per topic.\n    id           Topic ID\n    number       Topic number. Pass it to `wikino topic get` and `wikino page list --topic`\n    name         Topic name\n    description  Topic description. An empty string when not set\n    visibility   Visibility (public, private)\n  `next_cursor` is the cursor of the next page, or null when there is none.\n  With `--all`, prints JSON Lines where each line is one item, without `next_cursor`.\n  When there are no topics, returns an empty list with exit code 0.",
  "short": "List topics",
  "subcommands": [],
  "usage": "wikino topic list [flags]"
}

