      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Works with the pages of a space.\n\nA page is identified by its page number, which is unique within the space.\nYou can find it in `number` of `wikino page list` or in the `/pages/{number}` part of the web URL.",
  "output": "  See the help of each subcommand.",
  "short": "Work with pages",
  "subcommands": [
    {
      "command": "wikino page backlinks",
      "name": "backlinks",
      "short": "List the pages that link to a page"
    },
    {
      "command": "wikino page create",
      "name": "create",
      "short": "Create a page"
    },
    {
      "command": "wikino page get",
      "name": "get",
      "short": "Show a page"
    },
    {
      "command": "wikino page links",
      "name": "links",
      "short": "List the pages a page links to"
    },
    {
      "command": "wikino page list",
