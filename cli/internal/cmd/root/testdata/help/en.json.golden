  "examples": "  # List recently updated pages\n  wikino page list\n\n  # List the pages of topic 3, including unpublished ones\n  wikino page list --topic 3 --status all\n\n  # Find the number of the page titled \"Minutes\" in topic 3\n  wikino page list --topic 3 --title Minutes --jq '.items[].number'\n\n  # Print pages updated since a time, with bodies, one per line\n  wikino page list --modified-since 2026-10-01T00:00:00Z --all --fields number,title,body",
  "flags": [
