      "short": "List pages"
    },
    {
      "command": "wikino page search",
      "name": "search",
      "short": "Search pages by keywords"
    },
    {
      "command": "wikino page update",
      "name": "update",
      "short": "Update a page"
    }
  ],
  "usage": "wikino page <command>"
}

