=== wikino topic list --help --json
{
  "args": [],
  "command": "wikino topic list",
  "errors": "  2  `--limit` is less than 1, `--all` is combined with `--cursor`, or `--fields` has an unknown field\n  3  Not logged in, or the token is invalid or expired (401)\n  4  The token lacks the topic:read scope (403)\n  7  The `--cursor` value is invalid (422). Remove `--cursor` and fetch again from the first page",
  "examples": "  # List topics\n  wikino topic list\n\n  # Print the number and name of every topic, one per line\n  wikino topic list --all --fields number,name",
  "flags": [
    {
      "default": "false",
      "description": "Follow every page to fetch all items and print them as JSON Lines, one per line",
      "name": "all",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Cursor (cursor) of the following page to fetch (next_cursor in the previous output)",
      "name": "cursor",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "0",
      "description": "Number of items per page (n. Defaults to 20; values over 100 are treated as 100)",
      "name": "limit",
      "shorthand": "",
      "type": "int32"
    }
  ],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
