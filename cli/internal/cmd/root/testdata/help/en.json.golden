{
  "args": [],
  "command": "wikino auth status",
  "errors": "  2  With `WIKINO_TOKEN`, no space is given or `--member` is given\n  3  Not logged in, the saved token is missing, or the token is invalid or expired (401)\n  5  The token does not belong to the space (404)\n  If some credentials could not be checked, all items are printed and the command exits with the exit code of the first failed item.\n  The reason is in the item's `error`, not on stderr.",
  "examples": "  # Check all saved credentials\n  wikino auth status\n\n  # Print only the token scopes for the space my-space\n  wikino auth status --space my-space --jq '.items[].token.scopes'",
  "flags": [],
  "inherited_flags": [
    {
