    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Prints the token owner's draft of the page with the given page number, including its body.\n\nWith `--md`, prints it as a page file in the Wikino file format (Markdown with frontmatter).\nFor reading the body, `--md` is better because newlines and quotes are not escaped.\nFor a large draft, write it to a file with `--md` and read only the parts you need.\n\n`etag` in the output is the version of the draft.\nWhen updating the draft, pass the version you read to `--if-match`.\n\nReading a draft of a page in a private topic requires the topic:read scope on the token in addition to draft_page:read.",
  "output": "  Prints the draft with the fields of `wikino draft list` (without excerpt, with body) plus the following.\n    etag  The version of the draft (the value of the ETag response header). Pass it to `--if-match` of commands that update the draft\n  With `--md`, prints a page file in the Wikino file format instead of JSON.\n  The frontmatter keys starting with `wikino_` hold the page number, title, version, topic number, modification time, and URL, followed by the body as is.\n  Drafts have no publication status, so `wikino_status` is not written.\n  When the body itself starts with frontmatter, the keys are added to that block.",
  "short": "Print the content of a draft",
  "subcommands": [],
  "usage": "wikino draft get <page_number> [flags]"
}

=== wikino draft list --help --json
{
  "args": [],
  "command": "wikino draft list",
  "errors": "  2  `--limit` is less than 1, `--all` is combined with `--cursor`, or `--fields` has an unknown field\n  3  Not logged in, or the token is invalid or expired (401)\n  4  The token lacks the draft_page:read scope (403)\n  7  The `--cursor` value is invalid (422). Remove `--cursor` and fetch again from the first page",
  "examples": "  # List your drafts\n  wikino draft list\n\n  # Print only the numbers of pages that have drafts\n  wikino draft list --jq '.items[].page_number'\n\n  # Print all drafts with their bodies, one per line\n  wikino draft list --all --fields page_number,title,body",
  "flags": [
    {
      "default": "false",
