=== wikino --help --json
{
  "args": [],
  "command": "wikino",
  "errors": "  The exit code tells the kind of failure.\n  0    Success\n  1    Unexpected failure: network failure, server error (5xx), etc.\n  2    Usage error: invalid arguments or flags, unknown subcommand\n  3    Authentication failed: not logged in, invalid or expired token (401)\n  4    Permission denied: missing token scopes, etc. (403)\n  5    Not found (404)\n  6    Conflict: version mismatch (412) or missing (428), already exists (409)\n  7    Validation error (422)\n  8    Rate limited (429)\n  9    Confirmation required: an irreversible operation or publishing without `--yes`. Prints what will happen and the command to run after approval to stdout\n  130  Interrupted: Ctrl-C\n\n  When stderr is not a TTY or `--json` is given, errors are printed to stderr as single-line JSON.\n    {\"error\": {\"code\": \"usage_error\", \"message\": \"...\", \"hint\": \"...\", \"status\": 412}}\n  `hint` tells what to do next. `status` is the HTTP status of the API response and is omitted for errors not from the API.",
  "examples": "  # Show the version\n  wikino --version",
  "flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Show the version",
      "name": "version",
      "shorthand": "",
      "type": "bool"
    }
  ],
  "inherited_flags": [],
  "long": "A command-line tool that reads and writes pages and drafts through the Wikino public API.",
  "output": "  Prints human-readable output when stdout is a TTY, and JSON when it is not or when `--json` is given.\n  Selecting fields with `--fields` or giving `--jq` also prints JSON.\n  Only results go to stdout; progress and warnings go to stderr.",
  "short": "Command-line tool for Wikino",
  "subcommands": [
    {
      "command": "wikino api",
      "name": "api",
      "short": "Call the public API directly with authentication"
    },
    {
      "command": "wikino attachment",
      "name": "attachment",
      "short": "Work with attachments"
    },
    {
      "command": "wikino auth",
      "name": "auth",
      "short": "Manage login and credentials"
    },
    {
      "command": "wikino draft",
      "name": "draft",
      "short": "Work with page drafts"
    },
    {
      "command": "wikino page",
      "name": "page",
      "short": "Work with pages"
    },
    {
      "command": "wikino skill",
      "name": "skill",
      "short": "Manage the skill for coding agents"
    },
    {
      "command": "wikino topic",
      "name": "topic",
      "short": "Work with topics"
    }
  ],
  "usage": "wikino <command>"
}

=== wikino api --help --json
{
  "args": [
    {
      "name": "method",
      "required": true,
      "variadic": false
    },
    {
      "name": "path",
      "required": true,
      "variadic": false
    }
  ],
  "command": "wikino api",
  "errors": "  1  Server error (5xx) or network failure, or `--jq` on a non-JSON response\n  2  Unsupported method, a path that is not from `/api/v1` (a URL or one containing `..`), a malformed `--header` or an authentication header, `--fields`, `--input` on GET, an unreadable `--input` file, or `--input -` on an operation that needs confirmation\n  3  Not logged in, or the token is invalid or expired (401)\n  4  The token lacks a required scope (403)\n  5  Nothing matches the path (404)\n  6  Conflict (409), version mismatch (412), or missing version (428). Pass `If-Match` with `--header`\n  7  Invalid body (400, 422)\n  8  Rate limited (429)\n  9  An operation that needs the user's confirmation (deleting or publishing a draft) without `--yes`",
  "examples": "  # Get only 5 pages\n  wikino api GET '/spaces/{space}/pages?limit=5'\n\n  # Change the title of page 12 (the version is the etag of `wikino page get 12`)\n  echo '{\"title\": \"Weekly meeting\"}' | wikino api PATCH '/spaces/{space}/pages/12' --input - --header 'If-Match: \"d41d8cd9\"'\n\n  # Check the request without sending it\n  wikino api POST '/spaces/{space}/pages' --input page.json --dry-run\n\n  # Get the OpenAPI description\n  wikino api GET /openapi.yaml",
  "flags": [
    {
      "default": "false",
      "description": "Print the requests that would be sent without sending them",
      "name": "dry-run",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "[]",
      "description": "Header (header) to add to the request, as \"Name: value\" (can be repeated)",
      "name": "header",
      "shorthand": "H",
      "type": "stringArray"
    },
    {
      "default": "",
      "description": "File (file) to read the request body from (- for standard input)",
      "name": "input",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Run without asking for the user's confirmation",
      "name": "yes",
      "shorthand": "",
      "type": "bool"
    }
  ],
  "inherited_flags": [
    {
      "default": "[]",
      "description": "Comma-separated fields to print (e.g. number,title; applied to each item in lists)",
      "name": "fields",
      "shorthand": "",
      "type": "stringSlice"
    },
    {
      "default": "false",
      "description": "Show help (as JSON when combined with --json)",
      "name": "help",
      "shorthand": "h",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Host url (defaults to the default host, or https://wikino.app)",
      "name": "host",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Filter results with a jq expr (applied after --fields)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "Print results as JSON even on a TTY",
      "name": "json",
      "shorthand": "",
      "type": "bool"
    },
    {
      "default": "",
      "description": "Member atname (to choose when the space has credentials for several members)",
      "name": "member",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "",
      "description": "Space identifier (space)",
      "name": "space",
      "shorthand": "",
      "type": "string"
    }
  ],
  "long": "Calls the public API (`/api/v1`) directly with the credentials you are logged in with.\nUse it for operations the CLI has no command for yet.\n\n<path> is a path from `/api/v1` and may include a query (e.g. /spaces/{space}/pages?limit=5).\n`{space}` in the path is replaced with the identifier of the space the command runs in (`--space`, `WIKINO_SPACE`, or the default space).\nURLs, paths starting with `/api/v1`, and paths containing `..` are rejected.\n\nUnless Content-Type is given with `--header`, the `--input` body is sent as JSON Merge Patch (`application/merge-patch+json`) for PATCH and as JSON otherwise.\nOperations that need the user's confirmation, such as irreversible operations and publishing, are not sent without `--yes`.\nWhen not on a TTY, it prints what will happen (`changes`) and the command to run after approval (`confirm_command`) as JSON, and exits with code 9.\nWith `--dry-run`, no requests are sent to the public API, including read requests, and the requests that would be sent are printed.\n\nCheck the operations and paths of the API in the OpenAPI description, available with `wikino api GET /openapi.yaml`.",
  "output": "  Prints the body of a successful response as returned by the API (the CLI adds no fields).\n  JSON responses are indented on a TTY. With `--jq`, prints the result of applying it to the response JSON.\n  Prints nothing for responses without a body (such as 204).\n  With `--dry-run`, prints the requests that would be sent as {\"dry_run\": true, \"requests\": [{\"method\", \"url\", \"headers\", \"body\"}]}. The Authorization value is redacted.\n  Failed responses (4xx, 5xx) are printed to standard error as errors, as with other commands.",
  "short": "Call the public API directly with authentication",
  "subcommands": [],
  "usage": "wikino api <method> <path> [flags]"
}

