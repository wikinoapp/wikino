      "type": "string"
    },
    {
      "default": "",
      "description": "jqの式 (expr) で結果を絞り込む (--fieldsの後に適用する)",
      "name": "jq",
      "shorthand": "",
      "type": "string"
    },
    {
      "default": "false",
      "description": "TTYでも結果をJSONで出す",
      "name": "json",
      "shorthand": "",
