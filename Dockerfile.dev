# syntax=docker/dockerfile:1.7

FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# --- BuildKit apt cache configuration ---
# [Ja] BuildKit の apt キャッシュ設定
#
# Disable apt's automatic cleanup so the .debs downloaded into the
# BuildKit cache mount (/var/cache/apt + /var/lib/apt) survive across
# layers and rebuilds, keeping the apt cache hot.
#
# [Ja] apt の自動クリーンを無効化し、/var/cache/apt と /var/lib/apt のキャッシュマウントに
# 入った .deb がレイヤーや再ビルドをまたいで残るようにして、apt キャッシュを温存する。
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
      > /etc/apt/apt.conf.d/keep-cache

# --- System packages ---
# [Ja] システムパッケージ
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu
apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  bubblewrap                # Required by Codex for Linux sandboxing [Ja] Codex の Linux sandbox に必要
  build-essential
  ca-certificates           # Required for HTTPS connections [Ja] HTTPS 接続に必要
  curl
  file                      # Required by Shrine for image uploads (Rails) [Ja] Shrine による画像アップロードに必要 (Rails)
  fonts-noto-cjk            # Japanese (CJK) font for headless chromium screenshots [Ja] headless chromium のスクショ用の日本語 (CJK) フォント
  fzf                       # Used by Claude Code [Ja] Claude Code で使用
  git
  gnupg                     # Required for the PostgreSQL GPG key and apt repository [Ja] PostgreSQL の GPG キーと apt リポジトリに必要
  imagemagick               # Required by Shrine for image uploads (Rails) [Ja] Shrine による画像アップロードに必要 (Rails)
  jq                        # Used by Claude Code [Ja] Claude Code で使用
  libffi-dev                # Required to build Ruby extensions [Ja] Ruby 拡張のビルドに必要
  libglib2.0-0              # libvips dependency (Rails) [Ja] libvips の依存パッケージ (Rails)
  libreadline-dev           # Required by the Ruby readline extension [Ja] Ruby の readline 拡張に必要
  libssl-dev                # Required for SSL-related builds [Ja] SSL 関連のビルドに必要
  libvips42                 # Image processing library (Rails) [Ja] 画像処理ライブラリ (Rails)
  libyaml-dev               # Required by the psych gem (Rails) [Ja] psych gem のインストールに必要 (Rails)
  lsb-release               # Required to configure the PostgreSQL apt repository [Ja] PostgreSQL の apt リポジトリ設定に必要
  nano                      # Used by Claude Code [Ja] Claude Code で使用
  net-tools                 # Used by Claude Code for netstat (network debugging) [Ja] Claude Code で使用 netstat (ネットワークデバッグ用)
  procps                    # Provides ps for playwright-cli kill-all [Ja] playwright-cli kill-all 用の ps を提供
  psmisc                    # Used by Claude Code for fuser (process identification) [Ja] Claude Code で使用 fuser (プロセス特定用)
  ripgrep                   # Used by Claude Code [Ja] Claude Code で使用
  sudo
  tree                      # Used by Claude Code [Ja] Claude Code で使用
  unzip
  vim                       # Used by Claude Code [Ja] Claude Code で使用
  zlib1g-dev                # Required by the Ruby zlib extension (mandatory for gem install) [Ja] Ruby の zlib 拡張に必要 (gem install に必須)
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- PostgreSQL client ---
# [Ja] PostgreSQL クライアント
#
# Place the apt repository key under /etc/apt/keyrings and reference it
# via [signed-by=...]. The trusted.gpg.d/ approach is deprecated on
# modern Debian releases.
#
# [Ja] apt リポジトリの鍵は /etc/apt/keyrings/ に置き、[signed-by=...] で参照する。
# trusted.gpg.d/ 方式は現代の Debian では非推奨。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg && \
    chmod 0644 /etc/apt/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt update && \
    apt install -y --no-install-recommends libpq-dev postgresql-client-18

# --- mise (development tool version manager) ---
# [Ja] mise (開発ツールバージョンマネージャー)
#
# Use the shims approach recommended for Docker (PATH includes
# /mise/shims).
#
# [Ja] Docker 向けの推奨設定として shims 方式を使用する (PATH に /mise/shims を含める)。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Install Go, Ruby, Node.js, and pnpm via mise.
# [Ja] Go、Ruby、Node.js、pnpm を mise 経由でインストールする。
RUN mise install go@1.26.4 && \
    mise install ruby@3.4.4 && \
    mise install node@24.13.0 && \
    mise install node@20.19.0 && \
    mise install node@20.16.0 && \
    mise install pnpm@10.25.0 && \
    mise install pnpm@10.12.3

# Set global defaults.
# [Ja] グローバルデフォルトを設定する。
RUN mise use --global go@1.26.4 && \
    mise use --global ruby@3.4.4 && \
    mise use --global node@24.13.0 && \
    mise use --global pnpm@10.25.0

# --- dbmate ---
ARG DBMATE_VERSION=v2.33.0
ARG DBMATE_SHA256=dfd4027141b6e4357158099bdfe6c02b286af70f8e49057937744cf80b38ea1c
RUN curl -fsSL -o /tmp/dbmate "https://github.com/amacneil/dbmate/releases/download/${DBMATE_VERSION}/dbmate-linux-amd64" && \
    echo "${DBMATE_SHA256}  /tmp/dbmate" | sha256sum -c - && \
    mv /tmp/dbmate /usr/local/bin/dbmate && \
    chmod +x /usr/local/bin/dbmate

# --- hivemind ---
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -o /tmp/hivemind.gz "https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz" && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- golangci-lint ---
ARG GOLANGCI_LINT_VERSION=v2.11.4
ARG GOLANGCI_LINT_SHA256=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
RUN GOLANGCI_LINT_DIR="golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-amd64" && \
    curl -fsSL -o /tmp/golangci-lint.tar.gz "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/${GOLANGCI_LINT_DIR}.tar.gz" && \
    echo "${GOLANGCI_LINT_SHA256}  /tmp/golangci-lint.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp && \
    mv "/tmp/${GOLANGCI_LINT_DIR}/golangci-lint" /usr/local/bin/golangci-lint && \
    chmod +x /usr/local/bin/golangci-lint && \
    rm -rf "/tmp/golangci-lint.tar.gz" "/tmp/${GOLANGCI_LINT_DIR}"

# --- GitHub CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && \
    apt install -y --no-install-recommends gh

# --- Playwright browser (Go E2E) ---
# [Ja] Playwright ブラウザ (Go E2E)
#
# Pin to the @playwright/test version in go/e2e/pnpm-lock.yaml; the bundled
# Chromium build is tied to it, so bump them together. Install into a shared
# path (PLAYWRIGHT_BROWSERS_PATH) as root so install-deps can run apt, then
# chown it to the developer user that runs the tests. ~/.cache/ms-playwright
# is not a mounted volume, so baking the browser into the image avoids
# re-downloading it on every container recreation.
#
# [Ja] go/e2e/pnpm-lock.yaml の @playwright/test に固定する。同梱の Chromium
# ビルドはこれに紐づくため揃えて更新する。install-deps が apt を要するため root で
# 共有パス (PLAYWRIGHT_BROWSERS_PATH) に入れ、テストを実行する developer ユーザーに
# chown する。~/.cache/ms-playwright はマウントされたボリュームではないため、
# ブラウザをイメージに焼き込むとコンテナ再作成のたびの再ダウンロードを避けられる。
ARG PLAYWRIGHT_VERSION=1.58.2
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    npx --yes playwright@${PLAYWRIGHT_VERSION} install --with-deps chromium && \
    chown -R ${USER_ID}:${GROUP_ID} /ms-playwright

# --- Create the developer user ---
# [Ja] 開発者ユーザーを作成する
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Go cache directories ---
# [Ja] Go キャッシュディレクトリ
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- mise data directory permissions ---
# [Ja] mise のデータディレクトリの権限設定
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

# --- 1Password CLI config directory ---
# [Ja] 1Password CLI 設定ディレクトリ
#
# The op-config named volume is mounted here. Docker copies ownership from the
# image only when the volume is created empty, so the directory has to exist
# with the developer user's ownership beforehand for `op` to write its config.
#
# [Ja] 名前付きボリューム op-config をここにマウントする。Docker がイメージ側の
# 所有権を引き継ぐのはボリュームが空で新規作成されたときだけのため、`op` が設定を
# 書き込めるよう開発者ユーザー所有のディレクトリを事前に用意しておく。
#
# A volume created before this directory existed stays root-owned, and
# rebuilding the image does not change it. Remove it (docker volume rm) so it is
# recreated empty and picks up the ownership.
#
# [Ja] このディレクトリを用意する前に作られたボリュームは root 所有のままで、
# イメージを再ビルドしても変わらない。削除 (docker volume rm) して空の状態から
# 作り直すことで所有権が反映される。
RUN install -d -o ${USER_ID} -g ${GROUP_ID} /home/${USERNAME}/.config && \
    install -d -o ${USER_ID} -g ${GROUP_ID} -m 0700 /home/${USERNAME}/.config/op

WORKDIR /workspace
USER ${USERNAME}

# --- Create .zshrc ---
# [Ja] .zshrc の作成
RUN touch ~/.zshrc

# --- mise shell setup ---
# [Ja] mise のシェル設定
#
# In Docker we use the shims approach (PATH already includes
# /mise/shims). `mise activate` would bypass the shims and insert direct
# paths for the global defaults, which disables per-directory version
# switching, so we do not activate it here.
#
# [Ja] Docker 環境では shims 方式を使用する (PATH に /mise/shims を含めている)。
# mise activate は shims をバイパスしてグローバルデフォルトの直接パスを PATH に
# 追加してしまい、ディレクトリごとのバージョン切り替えが効かなくなるため、
# ここでは実行しない。
RUN mise reshim

# --- 1Password CLI ---
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Codex ---
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# --- Playwright CLI (agent-oriented browser automation) ---
# [Ja] Playwright CLI (エージェント向けブラウザ操作)
#
# Install the agent-oriented playwright-cli under every mise-managed Node
# version selected within this monorepo, then generate its shims. Bake its
# Chromium into a dedicated browsers path instead of the shared
# /ms-playwright above: playwright-cli pins a newer playwright-core than the
# @playwright/test E2E suite, so it needs a different Chromium build, and
# Playwright's install-time GC prunes browsers whose owning playwright-core
# link is unreadable. The E2E link points into root-only /root, so a shared
# install as this user would delete the E2E Chromium. System deps came from
# @playwright/test's --with-deps, so --with-deps is omitted here.
#
# [Ja] エージェント向けの playwright-cli を、この monorepo 内で選択される mise 管理の
# 各 Node バージョン配下に install してから shim を作る。その Chromium は上の共有
# /ms-playwright ではなく専用の browsers パスに焼き込む。playwright-cli は
# @playwright/test (E2E) より新しい playwright-core を pin するため別の Chromium
# ビルドを要し、また Playwright の install 時 GC は owning playwright-core リンクが
# 読めないブラウザを prune する。E2E のリンクは root 専有の /root を指すため、
# このユーザーで共有 install すると E2E 用 Chromium が消える。system 依存は
# @playwright/test の --with-deps で導入済みのため、ここでは --with-deps は付けない。
ARG PLAYWRIGHT_CLI_VERSION=0.1.17
ENV WIKINO_PLAYWRIGHT_CLI_BROWSERS_PATH=/ms-playwright-cli
RUN sudo install -d -o ${USER_ID} -g ${GROUP_ID} ${WIKINO_PLAYWRIGHT_CLI_BROWSERS_PATH} && \
    mise exec node@20.16.0 -- npm install -g @playwright/cli@${PLAYWRIGHT_CLI_VERSION} && \
    mise exec node@20.19.0 -- npm install -g @playwright/cli@${PLAYWRIGHT_CLI_VERSION} && \
    mise exec node@24.13.0 -- npm install -g @playwright/cli@${PLAYWRIGHT_CLI_VERSION} && \
    mise reshim && \
    PLAYWRIGHT_BROWSERS_PATH=${WIKINO_PLAYWRIGHT_CLI_BROWSERS_PATH} \
      mise exec node@24.13.0 -- playwright-cli install-browser chromium

# --- Go tools ---
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
ENV PATH="${GOPATH}/bin:${PATH}"
RUN go install github.com/air-verse/air@latest

# --- Ruby tools ---
RUN gem install bundler -v 2.5.16

# --- Shell setup ---
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# --- Git configuration ---
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
