<header class="flex items-center gap-2 px-2">
  <%# Empty spacer paired with the trailing flex-1 so the breadcrumb stays centered. %>
  <%# [Ja] 末尾の flex-1 と対になる空のスペーサー。パンくずを中央寄せに保つ。 %>
  <div class="flex-1"></div>

  <div class="<%= max_width_class_name %> w-full px-4">
    <div class="w-fit">
      <%= breadcrumb %>
    </div>
  </div>

  <div class="flex-1">
  </div>
</header>
